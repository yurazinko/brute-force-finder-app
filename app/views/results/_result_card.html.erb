<%
  current_tab = params[:current_tab].presence || params[:status].presence || "unread"
  is_on_inbox_tab = [nil, "unread"].include?(current_tab)

  is_watched = result.status == 'watched' || result.acknowledged?
  should_dim = is_watched && is_on_inbox_tab

  engine = result.engine.presence || "N/A"

  score = result.relevance_score.to_i
  score_badge_class = case
                      when score >= 300 then "bg-emerald-500/10 text-emerald-400 border-emerald-500/30"
                      when score >= 100 then "bg-blue-500/10 text-blue-400 border-blue-500/30"
                      when score > 0   then "bg-amber-500/10 text-amber-400 border-amber-500/30"
                      else                  "bg-gray-500/10 text-gray-400 border-gray-500/30"
                      end

  keywords = Array(result.matched_keywords)
%>

<div id="<%= dom_id(result) %>"
     data-result-card-id="<%= result.id %>"
     data-controller="read-status result-card"
     data-read-status-url-value="<%= result_path(result) %>"
     data-read-status-current-status-value="<%= result.status %>"
     class="p-4 sm:p-5 border border-breeze-border rounded-xl hover:border-blue-500/40 hover:bg-blue-500/[0.02] transition bg-breeze-bg/50 flex flex-col gap-2.5 <%= 'opacity-50 duration-500 pointer-events-none' if should_dim %>">

  <div class="flex items-start justify-between gap-3">
    <a href="<%= result.url %>"
      target="_blank"
      rel="noopener"
      data-turbo="false"
      data-action="click->read-status#markAsRead contextmenu->read-status#markAsRead"
      data-current-tab="<%= current_tab %>"
      data-read-url="<%= result_path(result, status: params[:status], current_tab: current_tab, d: params[:d], show_acknowledged: params[:show_acknowledged]) %>"
      data-read-status="<%= result.status %>"
      class="text-breeze-accent font-bold hover:underline text-base sm:text-lg leading-tight block truncate flex-1">
      <%= result.title.presence || "Untitled Result" %>
    </a>

    <div class="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-bold border <%= score_badge_class %>" title="Relevance Score based on matched keyword groups">
      <span>🎯</span>
      <span><%= score %> pts</span>
    </div>
  </div>

  <div class="text-xs text-breeze-muted font-mono flex items-center gap-1.5 w-full min-w-0">
    <svg class="w-3.5 h-3.5 text-breeze-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 005.656-5.656l-1.1 1.1"></path>
    </svg>
    <span class="truncate block w-full" title="<%= result.url %>"><%= result.url %></span>
  </div>

  <div class="mt-1 bg-breeze-view p-3 rounded-lg border border-breeze-border shadow-sm h-20 sm:h-24 overflow-hidden">
    <p class="text-xs sm:text-sm text-gray-300 font-sans break-words line-clamp-3">
      <%= result.content.presence || "* No preview available *" %>
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] text-breeze-muted font-medium">Matches:</span>
      <% if keywords.any? %>
        <% keywords.each do |kw| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-blue-500/10 text-blue-300 border border-blue-500/20">
            <%= kw %>
          </span>
        <% end %>
      <% else %>
        <span class="text-[11px] text-breeze-muted italic">No keyword tags</span>
      <% end %>
    </div>

    <% if result.verification_status.to_s.start_with?("unverified") %>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20" title="Full page fetching failed or required captcha verification">
        ⚠️ <%= result.verification_status.humanize %>
      </span>
    <% end %>
  </div>

  <div class="mt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-breeze-border">
    <div class="flex flex-wrap items-center gap-2 order-2 sm:order-1 w-full sm:w-auto">

      <% unless result.status == "interesting" %>
        <%= button_to result_path(result,
                      "result[status]": :interesting,
                      status: params[:status],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      show_acknowledged: params[:show_acknowledged],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendDomCount" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-semibold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 px-2.5 py-2 sm:py-1 rounded-md shadow-sm transition flex items-center justify-center gap-1 cursor-pointer w-full sm:w-auto" do %>
          <span>⭐ Mark as Interesting</span>
        <% end %>
      <% end %>

      <% unless result.status == "garbage" %>
        <%= button_to result_path(result,
                      "result[status]": :garbage,
                      status: params[:status],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      show_acknowledged: params[:show_acknowledged],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendDomCount" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-semibold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 px-2.5 py-2 sm:py-1 rounded-md shadow-sm transition flex items-center justify-center gap-1 cursor-pointer w-full sm:w-auto" do %>
          <span>🗑️ Mark as Garbage</span>
        <% end %>
      <% end %>

      <% if %w[interesting watched garbage].include?(result.status) %>
        <%= button_to result_path(result,
                      "result[status]": :unread,
                      "result[acknowledged]": false,
                      status: params[:status],
                      show_acknowledged: params[:show_acknowledged],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendDomCount" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-medium bg-breeze-bg hover:bg-breeze-bg text-gray-300 border border-breeze-border px-2.5 py-2 sm:py-1 rounded-md transition flex items-center justify-center cursor-pointer w-full sm:w-auto" do %>
          <span>↩️ Move to Inbox</span>
        <% end %>
      <% end %>

    </div>

    <div class="flex items-center gap-2 order-1 sm:order-2 self-start sm:self-auto text-[10px] text-breeze-muted font-medium">
      <span><%= engine %></span>
      <span>•</span>
      <span>Discovered <%= time_ago_in_words(result.created_at) %> ago</span>
    </div>
  </div>
</div>