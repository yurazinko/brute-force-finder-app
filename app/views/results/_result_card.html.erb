<%
  quick_search = local_assigns[:quick_search] == true
  quick_search_token = local_assigns[:quick_search_token].presence || @quick_search_token
  current_tab = quick_search ? "unread" : (params[:current_tab].presence || params[:status].presence || "unread")
  is_on_inbox_tab = [nil, "unread"].include?(current_tab)

  is_watched = result.status == 'watched' || result.acknowledged?
  should_dim = is_watched && is_on_inbox_tab
  card_id = quick_search ? "quick_result_#{result.url_hash}" : dom_id(result)
  read_status_url = if quick_search
                      if quick_search_token.present?
                        mark_as_read_quick_search_path(quick_search_token, url_hash: result.url_hash)
                      end
                    else
                      mark_as_read_result_path(result)
                    end

  engine = result.engine.presence || "N/A"

  score = result.relevance_score.to_i
  score_badge_class = case
                      when score >= 80 then "text-emerald-400 border-emerald-500/30"
                      when score >= 40 then "text-blue-400 border-blue-500/30"
                      when score > 0   then "text-amber-400 border-amber-500/30"
                      else                  "text-breeze-muted border-breeze-border"
                      end

  keywords = Array(result.matched_keywords)
%>

<div id="<%= card_id %>"
     data-controller="<%= quick_search ? 'read-status' : 'read-status result-card' %>"
     data-read-status-current-status-value="<%= result.status %>"
     <% if quick_search %>
       data-quick-result="true"
       data-relevance-score="<%= score %>"
       data-verification-status="<%= result.verification_status %>"
       data-matched-count="<%= keywords.size %>"
     <% else %>
       data-result-card-id="<%= result.id %>"
       data-read-status-url-value="<%= result_path(result) %>"
     <% end %>
     class="p-4 sm:p-5 border border-breeze-border/80 rounded-xl hover:border-breeze-accent/50 hover:bg-breeze-view/40 transition-all bg-breeze-bg/40 flex flex-col gap-3 shadow-xs <%= 'opacity-50 duration-500' if should_dim %>">

  <div class="flex items-start justify-between gap-3">
    <div class="flex flex-col gap-1 min-w-0 flex-1">
      <% if !quick_search && @search.blank? %>
        <% parent_search =  result.search %>
        <div class="flex items-center gap-1.5">
          <%= link_to search_path(parent_search),
              data: { turbo: false },
              class: "inline-flex items-center gap-1 text-[11px] font-medium font-mono text-breeze-muted hover:text-breeze-accent hover:bg-breeze-accent/10 py-0.5 transition-colors w-fit truncate max-w-full",
              title: "View search campaign: #{parent_search.title}" do %>
            <span class="truncate"><%= parent_search.title %></span>
          <% end %>
        </div>
      <% end %>

      <a href="<%= result.url %>"
        target="_blank"
        rel="noopener"
        data-turbo="false"
        data-current-tab="<%= current_tab %>"
        data-read-url="<%= read_status_url %>"
        data-read-status="<%= result.status %>"
        class="text-breeze-accent font-bold hover:underline text-base sm:text-lg leading-snug block truncate min-w-0 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent rounded-sm" title="<%= result.title.presence || 'Untitled Result' %>">
        <%= result.title.presence || "Untitled Result" %>
      </a>
    </div>

    <!-- Relevance Score -->
    <div class="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-medium border <%= score_badge_class %>" title="Percentage of matched keyword groups; missing the first group is penalized">
      <span>🎯</span>
      <span><%= score %></span>
    </div>
  </div>

  <div class="text-xs text-breeze-muted font-mono flex items-stretch justify-between w-full min-w-0 bg-breeze-view/60 rounded-md border border-breeze-border/40 group overflow-hidden">
      <div class="truncate flex items-center gap-1.5 min-w-0 flex-1 px-2.5 py-1.5">
        <span class="truncate block w-full text-breeze-muted/80 hover:text-breeze-text transition-colors" title="<%= result.url %>">
          <%= highlight_target_domain(result) %>
        </span>
      </div>

      <% unless quick_search %>
        <%= link_to new_target_pattern_path(result_id: result.id, redirect_to: request.path),
            data: { turbo_frame: "modal" },
            class: "shrink-0 self-stretch opacity-85 hover:opacity-100 text-[11px] font-sans font-semibold bg-breeze-accent/10 hover:bg-breeze-accent/20 text-breeze-accent px-3 border-l border-breeze-accent/30 transition flex items-center gap-1.5 cursor-pointer rounded-r-md" do %>
          <span>✨</span>
          <span>Configure</span>
        <% end %>
      <% end %>
    </div>

  <div class="bg-breeze-view p-3 sm:p-3.5 rounded-lg border border-breeze-border/60 shadow-inner h-20 sm:h-24 overflow-hidden">
    <p class="text-xs sm:text-sm text-breeze-text font-sans break-words line-clamp-3 leading-relaxed">
      <%= result.content.presence || "* No preview content available *" %>
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 pt-0.5">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] text-breeze-muted font-semibold uppercase tracking-wider">Matches:</span>
      <% if keywords.any? %>
        <% keywords.each do |kw| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-blue-500/10 text-blue-300 border border-blue-500/20">
            <%= kw %>
          </span>
        <% end %>
      <% else %>
        <span class="text-[11px] text-breeze-muted/60 italic">No keyword tags matched</span>
      <% end %>
    </div>

    <% status = result.verification_status.to_s %>

    <% if status == "pending" %>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 shadow-2xs" title="Awaiting full page verification">
        ⏳ Pending verification
      </span>
    <% elsif status.start_with?("unverified") %>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 shadow-2xs" title="Full page fetching failed or required captcha verification">
        ⚠️ <%= status == "unverified_captcha" ? "CAPTCHA — not verified" : "Unverified: #{status.split('_').last}" %>
      </span>
    <% end %>
  </div>

  <div class="mt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2.5 border-t border-breeze-border/60">
    <% unless quick_search %>
    <div class="flex flex-wrap items-center gap-2 order-2 sm:order-1 w-full sm:w-auto">

      <% unless result.status == "interesting" %>
        <%= button_to result_path(result,
                      "result[status]": :interesting,
                      status: params[:status],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      show_acknowledged: params[:show_acknowledged],
                      show_less_relevant: params[:show_less_relevant],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendVisibleIds" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-semibold bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 border border-amber-500/30 px-3 py-1.5 rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer w-full sm:w-auto shadow-2xs" do %>
          <span>⭐</span>
          <span>Move to Starred</span>
        <% end %>
      <% end %>

      <% unless result.status == "garbage" %>
        <%= button_to result_path(result,
                      "result[status]": :garbage,
                      status: params[:status],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      show_acknowledged: params[:show_acknowledged],
                      show_less_relevant: params[:show_less_relevant],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendVisibleIds" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-semibold bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 border border-red-500/30 px-3 py-1.5 rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer w-full sm:w-auto shadow-2xs" do %>
          <span>🗑️</span>
          <span>Move to Trash</span>
        <% end %>
      <% end %>

      <% if %w[interesting watched garbage].include?(result.status) %>
        <%= button_to result_path(result,
                      "result[status]": :unread,
                      "result[acknowledged]": false,
                      status: params[:status],
                      show_acknowledged: params[:show_acknowledged],
                      d: params[:d],
                      q: params[:q],
                      sort: params[:sort],
                      search_ids: params[:search_ids],
                      search_id: @search&.id),
                      method: :patch,
                      form: { data: { action: "submit->result-card#appendVisibleIds" } },
                      data: { turbo_stream: true },
                      class: "text-xs font-medium bg-breeze-view hover:bg-breeze-border/40 text-breeze-muted hover:text-breeze-text border border-breeze-border px-3 py-1.5 rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer w-full sm:w-auto shadow-2xs" do %>
          <span>↩️</span>
          <span>Move to Inbox</span>
        <% end %>
      <% end %>

    </div>

    <% end %>

    <div class="flex items-center gap-2 <%= quick_search ? 'ml-auto' : 'order-1 sm:order-2 self-start sm:self-auto' %> text-[11px] text-breeze-muted font-medium bg-breeze-view/40 px-2.5 py-1 rounded-md border border-breeze-border/30">
      <span class="font-mono text-breeze-text/80"><%= engine %></span>
      <span class="text-breeze-border">•</span>
      <span><% if result.created_at.present? %>Discovered <%= time_ago_in_words(result.created_at) %> ago<% else %>Discovered recently<% end %></span>
    </div>
  </div>
</div>
