<div id="<%= dom_id(result) %>"
     data-controller="read-status"
     data-read-status-url-value="<%= result_path(result) %>"
     data-read-status-current-status-value="<%= result.status %>"
     data-turbo-permanent
     class="p-5 border border-gray-100 rounded-xl hover:border-blue-200 hover:bg-blue-50/10 transition bg-gray-50/50 flex flex-col gap-2 <%= 'opacity-60' if result.status == 'watched' %>">

  <a href="<%= result.url %>"
    target="_blank"
    rel="noopener"
    data-turbo="false"
    data-action="click->read-status#markAsRead contextmenu->read-status#markAsRead"
    data-read-url="<%= result_path(result, status: :watched, current_tab: (params[:status].presence || "unread"), d: params[:d]) %>"
    data-read-status="<%= result.status %>"
    class="text-blue-600 font-bold hover:underline text-lg leading-tight">
    <%= result.title.presence || "Untitled Result" %>
  </a>

  <div class="text-xs text-gray-400 font-mono break-all flex items-center gap-1">
    <svg class="w-3 h-3 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
    <%= result.url %>
  </div>

  <% if result.content.present? %>
    <p class="text-sm text-gray-600 mt-1 line-clamp-3 bg-white p-3 rounded-lg border border-gray-100 shadow-sm font-sans">
      <%= result.content %>
    </p>
  <% end %>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-gray-100">
    <div class="flex items-center gap-1.5">
      <% unless result.status == "interesting" %>
        <%= button_to result_path(result, status: :interesting, current_tab: params[:status], d: params[:d]), method: :patch, data: { turbo_stream: true }, class: "text-xs font-semibold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-md shadow-sm transition flex items-center gap-1 cursor-pointer" do %>
          ⭐ Mark as Interesting
        <% end %>
      <% end %>

      <% unless result.status == "watched" %>
        <%= button_to result_path(result, status: :watched, current_tab: params[:status], d: params[:d]), method: :patch, data: { turbo_stream: true }, class: "text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 px-2.5 py-1 rounded-md shadow-sm transition flex items-center gap-1 cursor-pointer" do %>
          👁️ Mark Watched
        <% end %>
      <% end %>

      <% unless result.status == "garbage" %>
        <%= button_to result_path(result, status: :garbage, current_tab: params[:status], d: params[:d]), method: :patch, data: { turbo_stream: true }, class: "text-xs font-semibold bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 px-2.5 py-1 rounded-md shadow-sm transition flex items-center gap-1 cursor-pointer" do %>
          🗑️ Mark as Garbage
        <% end %>
      <% end %>

      <% if %w[interesting watched garbage].include?(result.status) %>
        <%= button_to result_path(result, status: :unread, current_tab: params[:status], d: params[:d]), method: :patch, data: { turbo_stream: true }, class: "text-xs font-medium bg-gray-50 hover:bg-gray-100 text-gray-600 border border-gray-200 px-2.5 py-1 rounded-md transition cursor-pointer" do %>
          ↩️ Move to Inbox
        <% end %>
      <% end %>
    </div>

    <div class="text-[10px] text-gray-400 font-medium">
      Discovered <%= time_ago_in_words(result.created_at) %> ago
    </div>
  </div>
</div>