<% position = local_assigns.fetch(:position, "top") %>
<% current_tab = params[:current_tab].presence || params[:status].presence || "unread" %>
<% active_count = if counts
                    case current_tab
                    when "unread"      then counts.unread.to_i
                    when "watched"     then counts.watched.to_i
                    when "interesting" then counts.interesting.to_i
                    when "garbage"     then counts.garbage.to_i
                    else                    0
                    end
                  else
                    0
                  end %>
<% has_results = results.any? || active_count.positive? %>
<% selected_bulk_scope = params[:bulk_scope].presence || "visible" %>
<% filter_params = {
     status: params[:status].presence,
     d: params[:d].presence,
     q: params[:q].presence,
     sort: params[:sort].presence,
     show_acknowledged: params[:show_acknowledged].presence,
     show_less_relevant: params[:show_less_relevant].presence,
     bulk_scope: selected_bulk_scope
   }.compact %>

<% if search.present? %>
  <% actions = [
    {
      status: "unread",
      label: "Inbox",
      icon: "📥",
      confirm_visible: "Move all visible results on this page to Inbox?",
      confirm_all_matching: "Move all matching results in this tab to Inbox?",
      active_class: "bg-breeze-view hover:bg-breeze-border/40 text-breeze-muted hover:text-breeze-text border border-breeze-border",
      disabled_class: "bg-breeze-view/30 text-breeze-muted/40 border border-breeze-border/20"
    },
    {
      status: "watched",
      label: "Reviewed",
      icon: "👁️",
      confirm_visible: "Mark all visible results on this page as Reviewed?",
      confirm_all_matching: "Mark all matching results in this tab as Reviewed?",
      active_class: "bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 hover:text-sky-200 border border-sky-500/30",
      disabled_class: "bg-sky-500/5 text-sky-300/40 border border-sky-500/10"
    },
    {
      status: "interesting",
      label: "Starred",
      icon: "⭐",
      confirm_visible: "Mark all visible results on this page as Starred?",
      confirm_all_matching: "Mark all matching results in this tab as Starred?",
      active_class: "bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 border border-amber-500/30",
      disabled_class: "bg-amber-500/5 text-amber-300/40 border border-amber-500/10"
    },
    {
      status: "garbage",
      label: "Trash",
      icon: "🗑️",
      confirm_visible: "Move all visible results on this page to Trash?",
      confirm_all_matching: "Move all matching results in this tab to Trash?",
      active_class: "bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 border border-red-500/30",
      disabled_class: "bg-red-500/5 text-red-400/40 border border-red-500/10"
    }
  ] %>

  <div id="bulk_actions_<%= position %>"
       data-controller="bulk-actions"
       class="flex flex-wrap items-center gap-2 p-2 rounded-lg border border-breeze-border/0">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-breeze-muted uppercase tracking-wider hidden sm:inline">Bulk actions:</span>
      <label for="bulk_scope_<%= position %>" class="text-xs font-medium text-breeze-muted tracking-wider">Move</label>
      <select id="bulk_scope_<%= position %>"
              data-bulk-actions-target="scope"
              data-bulk-actions-scope-select="true"
              data-action="change->bulk-actions#syncScope"
              class="text-xs bg-breeze-bg text-breeze-text border border-breeze-border rounded-md px-2 py-1.5 focus:outline-none focus:border-breeze-accent">
        <option value="visible" <%= "selected" if selected_bulk_scope == "visible" %>>visible results</option>
        <option value="all_matching" <%= "selected" if selected_bulk_scope == "all_matching" %>>all results</option>
      </select>
    </div>

    <span class="text-xs font-medium text-breeze-muted tracking-wider hidden sm:inline">to:</span>

    <% actions.each do |action| %>
      <% action_disabled = !has_results || current_tab == action[:status] %>
      <%= button_to bulk_update_results_path,
                    method: :patch,
                    disabled: action_disabled,
                    params: { search_id: search.id, target_status: action[:status] }.merge(filter_params),
                    form: {
                      data: {
                        action: "submit->bulk-actions#prepareSubmit",
                        turbo: false
                      }
                    },
                    class: "text-xs font-semibold px-2.5 py-1 rounded-md transition-all flex items-center gap-1 shadow-2xs #{action_disabled ? action[:disabled_class] + ' cursor-not-allowed opacity-50' : action[:active_class] + ' cursor-pointer'}",
                    data: action_disabled ? {} : {
                      confirm_visible: action[:confirm_visible],
                      confirm_all_matching: action[:confirm_all_matching]
                    } do %>
        <span><%= action[:icon] %></span>
        <span><%= action[:label] %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
