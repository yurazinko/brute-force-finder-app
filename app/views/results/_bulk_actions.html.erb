<% position = local_assigns.fetch(:position, "top") %>
<% current_tab = params[:current_tab].presence || params[:status].presence || "unread" %>
<% has_results = results.any? %>
<% filter_params = {
     status: params[:status].presence,
     d: params[:d].presence,
     q: params[:q].presence,
     sort: params[:sort].presence,
     show_acknowledged: params[:show_acknowledged].presence,
     show_less_relevant: params[:show_less_relevant].presence
   }.compact %>

<% if search.present? %>
  <% actions = [
    {
      status: "unread",
      label: "Unread",
      icon: "↩️",
      confirm: "Move all currently visible matching results to Inbox?",
      active_class: "bg-breeze-view hover:bg-breeze-border/40 text-breeze-muted hover:text-breeze-text border border-breeze-border",
      disabled_class: "bg-breeze-view/30 text-breeze-muted/40 border border-breeze-border/20"
    },
    {
      status: "watched",
      label: "Reviewed",
      icon: "👁️",
      confirm: "Mark all currently visible matching results as Reviewed?",
      active_class: "bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 hover:text-sky-200 border border-sky-500/30",
      disabled_class: "bg-sky-500/5 text-sky-300/40 border border-sky-500/10"
    },
    {
      status: "interesting",
      label: "Starred",
      icon: "⭐",
      confirm: "Mark all currently visible matching results as Starred?",
      active_class: "bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 border border-amber-500/30",
      disabled_class: "bg-amber-500/5 text-amber-300/40 border border-amber-500/10"
    },
    {
      status: "garbage",
      label: "Trash",
      icon: "🗑️",
      confirm: "Move all currently visible matching results to Trash?",
      active_class: "bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 border border-red-500/30",
      disabled_class: "bg-red-500/5 text-red-400/40 border border-red-500/10"
    }
  ] %>

  <div id="bulk_actions_<%= position %>"
       class="flex flex-wrap items-center gap-2 p-2 rounded-lg border border-breeze-border/0">
    <span class="text-xs font-semibold text-breeze-muted uppercase tracking-wider hidden sm:inline">Mark visible as:</span>

    <% actions.each do |action| %>
      <% action_disabled = !has_results || current_tab == action[:status] %>
      <%= button_to bulk_update_results_path,
                    method: :patch,
                    disabled: action_disabled,
                    params: { search_id: search.id, target_status: action[:status] }.merge(filter_params),
                    form: {
                      data: {
                        controller: "bulk-actions",
                        action: "submit->bulk-actions#prepareSubmit",
                        turbo: false
                      }
                    },
                    class: "text-xs font-semibold px-2.5 py-1 rounded-md transition-all flex items-center gap-1 shadow-2xs #{action_disabled ? action[:disabled_class] + ' cursor-not-allowed opacity-50' : action[:active_class] + ' cursor-pointer'}",
                    data: action_disabled ? {} : { confirm: action[:confirm] } do %>
        <span><%= action[:icon] %></span>
        <span><%= action[:label] %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

