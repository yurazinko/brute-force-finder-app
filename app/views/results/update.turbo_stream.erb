<%
  current_tab = params[:current_tab]

  should_remove = (@result.status == "garbage" && current_tab != "garbage") ||
                  (@result.status == "interesting" && current_tab != "interesting") ||
                  (@result.status == "unread" && current_tab.present? && current_tab != "unread") ||
                  (@result.status == "watched" && current_tab.present? && current_tab != "watched")
%>

<% if should_remove %>
  <%= turbo_stream.remove dom_id(@result) %>
<% else %>
  <%= turbo_stream.replace dom_id(@result), partial: "results/result_card", locals: { result: @result } %>
<% end %>

<%= turbo_stream.replace "search_tabs_navigation" do %>
  <%= render "searches/tabs_counters", search: @search, counts: @counts %>
<% end %>
