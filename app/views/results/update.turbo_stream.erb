<%
  should_remove = (@result.status == "garbage" && params[:current_tab] != "garbage") ||
                    (@result.status == "unread" && params[:current_tab].present?)
%>

<% if should_remove %>
  <%= turbo_stream.remove dom_id(@result) %>
<% else %>
  <%= turbo_stream.replace dom_id(@result), partial: "results/result_card", locals: { result: @result } %>
<% end %>

<%= turbo_stream.update "counter_all_clean", html: (@search.calculate_counters[:all_clean] || 0).to_s %>
<%= turbo_stream.update "counter_unread", html: (@search.calculate_counters[:unread] || 0).to_s %>
<%= turbo_stream.update "counter_interesting", html: (@search.calculate_counters[:interesting] || 0).to_s %>
<%= turbo_stream.update "counter_watched", html: (@search.calculate_counters[:watched] || 0).to_s %>
<%= turbo_stream.update "counter_garbage", html: (@search.calculate_counters[:garbage] || 0).to_s %>
<%= turbo_stream.update "results_count", html: "Showing: #{@search.results.count}" %>