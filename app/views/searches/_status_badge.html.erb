<%
  badge_classes = case search.status
                  when 'completed'  then 'bg-green-100 text-green-800 border border-green-200'
                  when 'processing' then 'bg-blue-100 text-blue-800 border border-blue-200 animate-pulse font-bold'
                  when 'pending'    then 'bg-yellow-100 text-yellow-800 border border-yellow-200'
                  when 'failed'     then 'bg-red-100 text-red-800 border border-red-200'
                  else                   'bg-gray-100 text-gray-800 border border-gray-200'
                  end
%>

<span id="<%= dom_id(search) %>_badge"
      class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full tracking-wider <%= badge_classes %>">
  <%= search.status.upcase %>
</span>