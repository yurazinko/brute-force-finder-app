<div class="max-w-7xl mx-auto px-4 py-8">

  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-start gap-4">
    <div>
      <%= link_to '← Back to Campaigns', searches_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
      <h1 class="text-3xl font-bold text-gray-900 mt-2"><%= @search.title %></h1>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Global Filter:</span>
        <code class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs font-mono border border-gray-200">
          <%= @search.query_conditions %>
        </code>
      </div>
    </div>

    <div id="search_lifecycle_status" class="flex items-center gap-3">
      <span class="text-sm text-gray-500">Pipeline Status:</span>
      <%= render "searches/status_badge", search: @search %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl sticky top-6">

        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-bold text-gray-900">Target Pipeline</h2>
          <div class="flex items-center space-x-2 text-xs">
            <button type="button" onclick="toggleAllCheckboxes(true)" class="text-blue-600 font-medium hover:underline focus:outline-none cursor-pointer">Select All</button>
            <span class="text-gray-300">|</span>
            <button type="button" onclick="toggleAllCheckboxes(false)" class="text-gray-500 font-medium hover:underline focus:outline-none cursor-pointer">Clear All</button>
          </div>
        </div>

        <%= form_with(url: activate_search_path(@search), method: :post, local: true) do |f| %>

          <div class="space-y-4 max-h-[450px] overflow-y-auto pr-2 mb-6 border-b border-gray-100 pb-4" id="targets_selector_zone">
            <% if Category.exists? %>
              <% Category.includes(:targets).order(:name).each do |category| %>
                <% active_targets = category.targets.active %>
                <% next if active_targets.empty? %>

                <div class="category-group border border-gray-100 rounded-lg p-3 bg-gray-50/50">
                  <div class="flex justify-between items-center mb-3 pb-1 border-b border-gray-200/60">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider"><%= category.name %></h3>
                    <button type="button" onclick="toggleCategoryCheckboxes(this, true)" class="group-toggle-btn text-[10px] text-indigo-600 hover:underline font-semibold cursor-pointer">Select Group</button>
                  </div>

                  <div class="grid grid-cols-1 gap-1.5">
                    <% active_targets.order(:name).each do |target| %>
                      <label class="flex items-start space-x-3 py-1.5 px-2 rounded hover:bg-white border border-transparent hover:border-gray-100 cursor-pointer transition group">
                        <%= check_box_tag "target_ids[]", target.id, true, class: "target-checkbox mt-0.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer" %>
                        <div class="text-sm leading-tight">
                          <span class="text-gray-800 font-medium group-hover:text-blue-600 transition"><%= target.name %></span>
                          <span class="text-[11px] text-gray-400 block font-mono mt-0.5"><%= target.domain %></span>
                        </div>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-6 text-gray-400 text-sm">
                No categories found. <%= link_to "Create one first", categories_path, class: "text-blue-600 underline" %>.
              </div>
            <% end %>
          </div>

          <%= f.submit "Trigger Scraper Engine", class: "w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-sm hover:shadow transition text-center cursor-pointer transform active:scale-[0.98]" %>
        <% end %>

      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl min-h-[550px]">

        <div class="flex justify-between items-center border-b border-gray-100 pb-4 mb-6">
          <h2 class="text-xl font-bold text-gray-900">Scraped Results Pool</h2>
          <span class="text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-full" id="results_count">
            Total Extracted: <%= @results.count %>
          </span>
        </div>

        <div id="results_pool" class="space-y-4">
          <% if @results.any? %>
            <% @results.each do |result| %>
              <div class="p-5 border border-gray-100 rounded-xl hover:border-blue-200 hover:bg-blue-50/10 transition bg-gray-50/50 flex flex-col gap-2">
                <div class="flex justify-between items-start gap-4">
                  <a href="<%= result.url %>" target="_blank" rel="noopener" class="text-blue-600 font-bold hover:underline text-lg leading-tight">
                    <%= result.title.presence || "Untitled Result" %>
                  </a>
                </div>
                <div class="text-xs text-gray-400 font-mono break-all flex items-center gap-1">
                  <svg class="w-3 h-3 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                  <%= result.url %>
                </div>
                <% if result.content.present? %>
                  <p class="text-sm text-gray-600 mt-1 line-clamp-3 bg-white p-3 rounded-lg border border-gray-100 shadow-sm font-sans">
                    <%= result.content %>
                  </p>
                <% end %>
                <div class="text-[10px] text-gray-400 text-right mt-1">
                  Discovered <%= time_ago_in_words(result.created_at) %> ago
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-24 text-gray-400 border-2 border-dashed border-gray-200 rounded-xl bg-gray-50/30" id="empty_state">
              <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <p class="text-base font-medium text-gray-600">No data collected yet</p>
              <p class="text-xs text-gray-400 mt-1 max-w-xs mx-auto">Select target search engines from the sidebar and trigger the scraper engine to begin live parsing.</p>
            </div>
          <% end %>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  function toggleAllCheckboxes(status) {
    document.querySelectorAll('.target-checkbox').forEach(cb => {
      cb.checked = status;
    });

    // Оновлюємо текст на всіх локальних кнопках груп
    document.querySelectorAll('.group-toggle-btn').forEach(btn => {
      updateGroupButtonState(btn, status);
    });
  }

  function toggleCategoryCheckboxes(button, status) {
    const group = button.closest('.category-group');
    group.querySelectorAll('.target-checkbox').forEach(cb => {
      cb.checked = status;
    });
    updateGroupButtonState(button, status);
  }

  function updateGroupButtonState(button, isSelected) {
    if (isSelected) {
      button.innerText = "Clear Group";
      button.setAttribute('onclick', 'toggleCategoryCheckboxes(this, false)');
      button.className = "group-toggle-btn text-[10px] text-gray-500 hover:underline font-medium cursor-pointer";
    } else {
      button.innerText = "Select Group";
      button.setAttribute('onclick', 'toggleCategoryCheckboxes(this, true)');
      button.className = "group-toggle-btn text-[10px] text-indigo-600 hover:underline font-semibold cursor-pointer";
    }
  }
</script>