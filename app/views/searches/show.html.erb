<%= turbo_stream_from @search, :results %>

<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4 sm:space-y-6">
  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">
    <div class="lg:col-span-2 space-y-3">

      <div class="flex items-center justify-between gap-4 mb-0">
        <%= link_to '⬅️ Back to Campaigns', searches_path, class: "text-sm font-medium text-breeze-muted hover:text-breeze-text transition shrink-0" %>

        <div class="flex items-center gap-2">
          <%= link_to edit_search_path(@search),
                      class: "text-xs font-semibold text-breeze-accent hover:text-white bg-blue-50 hover:bg-blue-600 border border-blue-100 hover:border-blue-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 shadow-sm" do %>
            <span>⚙️</span>
            <span class="hidden sm:inline">Configure Campaign</span>
          <% end %>

          <%= button_to search_path(@search),
                        method: :delete,
                        data: { confirm: 'Are you sure you want to completely delete this campaign and all its results?' },
                        class: "text-xs font-semibold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 border border-red-100 hover:border-red-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
            <span>🗑️</span>
            <span class="hidden sm:inline">Delete Campaign</span>
          <% end %>
        </div>
      </div>

      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-breeze-text mt-1 break-words"><%= @search.title %></h1>
      </div>

      <div class="flex flex-col gap-1.5 mb-0.5">
        <code class="px-2 py-1 bg-breeze-bg text-gray-300 rounded text-xs font-mono border border-breeze-border block truncate" title="<%= @search.query_conditions %>">
          <%= @search.query_conditions %>
        </code>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <div id="search_lifecycle_status" class="flex items-center gap-2 text-sm bg-breeze-bg p-2 rounded-lg border border-breeze-border w-fit">
          <span class="text-breeze-muted font-medium">Pipeline:</span>
          <%= render "searches/status_badge", search: @search %>
        </div>
        <%= render "searches/live_tracker", message: @search.status == "processing" ? "Scraper engine is busy..." : "Waiting for scraper engine..." %>
      </div>
    </div>

    <div class="lg:col-span-1 border-t lg:border-t-0 lg:border-l border-breeze-border pt-4 lg:pt-0 lg:pl-6" data-controller="pipeline-selector">
      <%= form_with(url: activate_search_path(@search), method: :post) do |f| %>
        <% selected_target_ids = @search.target_ids %>
        <div class="flex justify-between items-center mb-2">
          <h2 class="text-xs sm:text-sm font-bold text-breeze-text uppercase tracking-wider">Target Pipeline</h2>
          <div class="flex items-center space-x-2 text-[11px]">
            <button type="button" data-action="click->pipeline-selector#toggleGlobal" data-pipeline-selector-status-param="true" class="text-breeze-accent font-semibold hover:underline cursor-pointer">Select All</button>
            <span class="text-gray-300">|</span>
            <button type="button" data-action="click->pipeline-selector#toggleGlobal" data-pipeline-selector-status-param="false" class="text-breeze-muted font-semibold hover:underline cursor-pointer">Clear All</button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-[160px] lg:max-h-[120px] overflow-y-auto pr-1 mb-3 border border-breeze-border p-2 rounded-lg bg-breeze-bg/50" id="targets_selector_zone">
          <% if Category.exists? %>
            <% Category.includes(:targets).order(:name).each do |category| %>
              <% active_targets = category.targets.active %>
              <% next if active_targets.empty? %>
              <div data-pipeline-selector-target="group" class="category-group border border-breeze-border/60 rounded-md p-2 bg-breeze-view flex flex-col justify-between">
                <div class="flex justify-between items-center border-b border-breeze-border pb-1 mb-1">
                  <h3 class="text-[10px] font-bold text-breeze-muted uppercase tracking-wider truncate"><%= category.name %></h3>
                  <button type="button" data-pipeline-selector-target="groupButton" data-action="click->pipeline-selector#toggleGroup" data-status="true" class="group-toggle-btn text-[9px] text-breeze-accent hover:underline font-semibold cursor-pointer shrink-0">Clear Group</button>
                </div>
                <div class="space-y-1 max-h-[80px] sm:max-h-[70px] overflow-y-auto">
                  <% active_targets.order(:name).each do |target| %>
                    <label class="flex items-center space-x-2 cursor-pointer text-xs group py-0.5">
                      <%= check_box_tag "target_ids[]", target.id, selected_target_ids.include?(target.id), class: "target-checkbox rounded border-breeze-border text-breeze-accent scale-90 cursor-pointer", data: { pipeline_selector_target: "checkbox" } %>
                      <span class="text-breeze-text truncate group-hover:text-breeze-accent" title="<%= target.domain %>"><%= target.name %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-2 text-breeze-muted text-xs">No categories found.</div>
          <% end %>
        </div>
        <%= f.submit "Trigger Scraper Engine", class: "w-full py-2.5 sm:py-2 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition text-center cursor-pointer transform active:scale-[0.99]" %>
      <% end %>
    </div>
  </div>

  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl min-h-[500px] flex flex-col justify-between">
    <%= turbo_frame_tag "results_pool", class: "block w-full flex flex-col justify-between min-h-[450px]", data: { turbo_action: "advance" } do %>
      <div>
        <div class="flex justify-between items-center border-b border-breeze-border pb-4 mb-4">
          <h2 class="text-lg sm:text-xl font-bold text-breeze-text">Scraped Results Pool</h2>
        </div>

        <div class="flex items-center gap-4 text-xs text-breeze-muted mb-6 bg-breeze-bg p-2.5 rounded-lg border border-breeze-border overflow-x-auto whitespace-nowrap [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          <span class="font-semibold text-breeze-muted uppercase tracking-wider sticky left-0 bg-breeze-bg pr-1">Discovery:</span>
          <div class="flex items-center gap-3">
            <%= link_to "All time", search_path(@search, status: params[:status]), class: "font-medium inline-block #{params[:d].blank? ? 'text-breeze-accent underline font-bold' : 'text-gray-300 hover:text-breeze-text'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past 24h", search_path(@search, status: params[:status], d: :day), class: "font-medium inline-block #{params[:d] == 'day' ? 'text-breeze-accent underline font-bold' : 'text-gray-300 hover:text-breeze-text'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past Week", search_path(@search, status: params[:status], d: :week), class: "font-medium inline-block #{params[:d] == 'week' ? 'text-breeze-accent underline font-bold' : 'text-gray-300 hover:text-breeze-text'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past Month", search_path(@search, status: params[:status], d: :month), class: "font-medium inline-block #{params[:d] == 'month' ? 'text-breeze-accent underline font-bold' : 'text-gray-300 hover:text-breeze-text'}" %>
          </div>
        </div>

        <div class="border-b border-breeze-border mb-6 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" id="search_tabs_navigation">
          <%= render "searches/tabs_counters", search: @search, counts: @counts %>
        </div>

        <div class="space-y-4" id="results_pool_list">
          <% if @results.any? %>
            <% @results.each do |result| %>
              <%= render partial: "results/result_card", locals: { result: result }, formats: [:html] %>
            <% end %>
          <% else %>
            <div class="text-center py-24 text-breeze-muted border-2 border-dashed border-breeze-border rounded-xl bg-breeze-bg/30 w-full" id="empty_state">
              <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <p class="text-base font-medium text-gray-300">No matching data in this filter</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-breeze-border flex justify-center custom-pagy-container">
        <%= turbo_frame_tag "results_pool_pagination", data: { controller: "infinite-scroll" } do %>
          <% if @pagy.next %>
            <%= link_to "Load more updates...",
                        search_path(@search, status: params[:status], d: params[:d], page: @pagy.next, format: :turbo_stream),
                        data: { infinite_scroll_target: "link" },
                        class: "invisible block text-center py-2 w-full" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>