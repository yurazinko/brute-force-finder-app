<%= turbo_stream_from @search, :results %>

<div class="max-w-7xl mx-auto px-4 py-4 space-y-6">
  <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2 space-y-3">
      <div>
        <%= link_to '← Back to Campaigns', searches_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
        <h1 class="text-2xl font-bold text-gray-900 mt-1"><%= @search.title %></h1>
      </div>
      <div class="flex flex-col gap-1.5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Global Filter:</span>
        <code class="px-2 py-1 bg-gray-50 text-gray-600 rounded text-xs font-mono border border-gray-100 block truncate" title="<%= @search.query_conditions %>">
          <%= @search.query_conditions %>
        </code>
      </div>
      <div class="flex items-center gap-3">
        <div id="search_lifecycle_status" class="flex items-center gap-2 text-sm bg-gray-50 p-2 rounded-lg border border-gray-100 w-fit">
          <span class="text-gray-500 font-medium">Pipeline:</span>
          <%= render "searches/status_badge", search: @search %>
        </div>
        <%= render "searches/live_tracker", message: "Waiting for scraper engine..." %>
      </div>
    </div>

    <div class="lg:col-span-1 border-t lg:border-t-0 lg:border-l border-gray-200 pt-6 lg:pt-0 lg:pl-6" data-controller="pipeline-selector">
      <%= form_with(url: activate_search_path(@search), method: :post) do |f| %>
        <% selected_target_ids = @search.target_ids %>
        <div class="flex justify-between items-center mb-2">
          <h2 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Target Pipeline</h2>
          <div class="flex items-center space-x-2 text-[11px]">
            <button type="button" data-action="click->pipeline-selector#toggleGlobal" data-pipeline-selector-status-param="true" class="text-blue-600 font-semibold hover:underline cursor-pointer">Select All</button>
            <span class="text-gray-300">|</span>
            <button type="button" data-action="click->pipeline-selector#toggleGlobal" data-pipeline-selector-status-param="false" class="text-gray-500 font-semibold hover:underline cursor-pointer">Clear All</button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-[120px] overflow-y-auto pr-1 mb-3 border border-gray-100 p-2 rounded-lg bg-gray-50/50" id="targets_selector_zone">
          <% if Category.exists? %>
            <% Category.includes(:targets).order(:name).each do |category| %>
              <% active_targets = category.targets.active %>
              <% next if active_targets.empty? %>
              <div data-pipeline-selector-target="group" class="category-group border border-gray-200/60 rounded-md p-2 bg-white flex flex-col justify-between">
                <div class="flex justify-between items-center border-b border-gray-100 pb-1 mb-1">
                  <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-wider"><%= category.name %></h3>
                  <button type="button" data-pipeline-selector-target="groupButton" data-action="click->pipeline-selector#toggleGroup" data-status="true" class="group-toggle-btn text-[9px] text-indigo-600 hover:underline font-semibold cursor-pointer">Clear Group</button>
                </div>
                <div class="space-y-1 max-h-[60px] overflow-y-auto">
                  <% active_targets.order(:name).each do |target| %>
                    <label class="flex items-center space-x-2 cursor-pointer text-xs group">
                      <%= check_box_tag "target_ids[]", target.id, selected_target_ids.include?(target.id), class: "target-checkbox rounded border-gray-300 text-blue-600 scale-90 cursor-pointer", data: { pipeline_selector_target: "checkbox" } %>
                      <span class="text-gray-700 truncate group-hover:text-blue-600" title="<%= target.domain %>"><%= target.name %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-2 text-gray-400 text-xs">No categories found.</div>
          <% end %>
        </div>
        <%= f.submit "Trigger Scraper Engine", class: "w-full py-2 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition text-center cursor-pointer transform active:scale-[0.99]" %>
      <% end %>
    </div>
  </div>

<div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl min-h-[500px] flex flex-col justify-between">

    <%= turbo_frame_tag "results_pool", class: "block w-full", data: { turbo_action: "advance" } do %>
      <div>
        <div class="flex justify-between items-center border-b border-gray-100 pb-4 mb-4">
          <h2 class="text-xl font-bold text-gray-900">Scraped Results Pool</h2>
          <span class="text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-full" id="results_count">
            Showing: <%= @results.count %>
          </span>
        </div>

        <div class="flex items-center gap-4 text-xs text-gray-500 mb-6 bg-gray-50 p-2.5 rounded-lg border border-gray-100">
          <span class="font-semibold text-gray-400 uppercase tracking-wider">Discovery Period:</span>
          <div class="flex items-center gap-3">
            <%= link_to "All time", search_path(@search, status: params[:status]), class: "font-medium #{params[:d].blank? ? 'text-blue-600 underline font-bold' : 'text-gray-600 hover:text-gray-900'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past 24h", search_path(@search, status: params[:status], d: :day), class: "font-medium #{params[:d] == 'day' ? 'text-blue-600 underline font-bold' : 'text-gray-600 hover:text-gray-900'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past Week", search_path(@search, status: params[:status], d: :week), class: "font-medium #{params[:d] == 'week' ? 'text-blue-600 underline font-bold' : 'text-gray-600 hover:text-gray-900'}" %>
            <span class="text-gray-300">|</span>
            <%= link_to "Past Month", search_path(@search, status: params[:status], d: :month), class: "font-medium #{params[:d] == 'month' ? 'text-blue-600 underline font-bold' : 'text-gray-600 hover:text-gray-900'}" %>
          </div>
        </div>

        <div class="border-b border-gray-200 mb-6" id="search_tabs_navigation">
          <%= render "searches/tabs_counters", search: @search, counts: @counts %>
        </div>

      <%= turbo_frame_tag "results_pool" do %>
        <%= render "searches/results_pool_content", results: @results %>
      <% end %>
      </div>
    <% end %>

    <% if @pagy && @pagy.pages > 1 %>
      <div class="mt-6 pt-4 border-t border-gray-100 flex justify-center custom-pagy-container">
        <%== @pagy.series_nav %>
      </div>
    <% end %>

  </div>
</div>