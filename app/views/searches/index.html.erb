<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Configure Search Rules</h1>
    <%= link_to 'Categories and Targets', categories_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow transition" %>
  </div>
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Scraping Searches</h1>
    <%= link_to 'New Search Criteria', new_search_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow transition" %>
  </div>

  <div class="bg-white shadow rounded-xl overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Conditions</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created At</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200" id="searches_list">
        <% @searches.each do |search| %>
          <tr id="<%= dom_id(search) %>" class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 font-medium text-gray-900">
              <%= link_to search.title, search_path(search), class: "hover:underline text-blue-600" %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 font-mono"><%= search.query_conditions %></td>
            <td class="px-6 py-4">
              <%= render "searches/status_badge", search: search %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= search.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <%= button_to 'Delete', search_path(search), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900 inline-block ml-4" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>