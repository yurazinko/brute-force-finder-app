<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4">

  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 pb-4 border-b border-b-gray-100">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Scraping Campaigns</h1>
      <p class="text-sm text-gray-500 mt-1">Configure and monitor your automated search processes and target constraints.</p>
    </div>
    <div class="flex flex-row items-center gap-2 sm:gap-3 shrink-0 w-full sm:w-auto">
      <%= link_to categories_path, class: "flex-1 sm:flex-none text-center bg-white hover:bg-gray-50 text-gray-700 font-medium py-2.5 sm:py-2 px-3 sm:px-4 border border-gray-200 rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>Categories & Targets</span>
      <% end %>
      <%= link_to new_search_path, class: "flex-1 sm:flex-none text-center bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 sm:py-2 px-3 sm:px-4 rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>New Search Criteria</span>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

    <table class="min-w-full table-fixed divide-y divide-gray-200 block md:table">
      <thead class="bg-gray-50/70 text-xs font-semibold text-gray-400 uppercase tracking-wider text-left hidden md:table-header-group">
        <tr>
          <th class="w-2/5 px-6 py-3.5">Campaign Info & Analytics</th>
          <th class="w-1/5 px-6 py-3.5">Query & Scope</th>
          <th class="w-1/6 px-6 py-3.5">Pipeline Status</th>
          <th class="w-1/6 px-6 py-3.5">Activity</th>
          <th class="w-12 px-6 py-3.5 text-right"></th>
        </tr>
      </thead>

<tbody class="divide-y divide-gray-100 bg-white block md:table-row-group" id="searches_list">
        <% if @searches.any? %>
          <% @searches.each do |search| %>
            <% last_discovery_time = search.results.last&.created_at %>
            <% unread_count      = @search_counts[[search.id, "unread"]] || 0 %>
            <% interesting_count = @search_counts[[search.id, "interesting"]] || 0 %>
            <% watched_count     = @search_counts[[search.id, "watched"]] || 0 %>
            <% garbage_count     = @search_counts[[search.id, "garbage"]] || 0 %>

            <tr id="<%= dom_id(search) %>" class="hover:bg-gray-50/40 transition-colors group block md:table-row p-4 md:p-0 relative border-b border-gray-100 last:border-b-0 md:border-b-0">

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell">
                <div class="mb-1.5 flex justify-between items-start gap-2">
                  <%= link_to search.title, search_path(search), class: "text-base font-semibold text-gray-900 hover:text-indigo-600 transition-colors block truncate max-w-[85%] md:max-w-full", title: search.title %>

                  <div class="md:hidden">
                    <%= button_to search_path(search),
                                  method: :delete,
                                  data: { confirm: 'Are you sure you want to delete this campaign?' },
                                  class: "text-gray-400 hover:text-red-600 p-1 rounded transition-colors cursor-pointer",
                                  title: "Delete Campaign" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.34 6.14m-4.08 0L10 9m4.34 3.65a3 3 0 1 1-6 0M4.5 5.05h15m-13.5 0a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2m-10.5 0h10.5" />
                      </svg>
                    <% end %>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 text-[11px] mb-3 md:mb-0">
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Inbox (Unread)">
                    <span>⬇️</span>
                    <span class="font-mono font-bold <%= unread_count > 0 ? 'text-emerald-600' : 'text-gray-400' %>"><%= unread_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Starred">
                    <span>⭐</span>
                    <span class="font-mono font-bold <%= interesting_count > 0 ? 'text-amber-500' : 'text-gray-400' %>"><%= interesting_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Watched">
                    <span>👁️</span>
                    <span class="font-mono font-semibold <%= watched_count > 0 ? 'text-indigo-600' : 'text-gray-400' %>"><%= watched_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Garbage">
                    <span>🗑️</span>
                    <span class="font-mono text-gray-400 <%= 'text-red-400 font-medium' if garbage_count > 0 %>"><%= garbage_count %></span>
                  </div>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell">
                <div class="mb-2 truncate max-w-full">
                  <span class="font-mono text-xs text-gray-600 bg-gray-100 px-1.5 py-0.5 rounded border border-gray-200/60 block truncate" title="<%= search.query_conditions %>">
                    <%= search.query_conditions %>
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 text-xs mb-3 md:mb-0">
                  <div class="shrink-0">
                    <% case search.time_frame %>
                    <% when 'day' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Past 24h</span>
                    <% when 'week' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200">Past Week</span>
                    <% when 'month' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">Past Month</span>
                    <% when 'year' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-slate-600 bg-slate-50 px-2 py-0.5 rounded border border-slate-200">Past Year</span>
                    <% else %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-slate-500 bg-slate-100/80 px-2 py-0.5 rounded border border-slate-200/60">Anytime</span>
                    <% end %>
                  </div>

                  <span class="text-gray-300 select-none text-[10px] hidden sm:inline">&bull;</span>

                  <div class="flex items-center gap-1 text-gray-500 font-medium bg-gray-50/50 px-2 py-0.5 rounded border border-gray-100">
                    <svg class="w-3 h-3 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span class="text-[11px] whitespace-nowrap">
                      <%= search.updated_at ? "#{time_ago_in_words(search.updated_at).gsub('about ', '')} ago" : "Never run" %>
                    </span>
                  </div>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell whitespace-nowrap md:pt-3.5 mb-3 md:mb-0">
                <div class="flex items-center gap-2 md:inline-block">
                  <span class="text-xs text-gray-400 md:hidden font-medium">Status:</span>
                  <%= render "searches/status_badge", search: search %>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top text-xs text-gray-500 block md:table-cell space-y-1">
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">Created:</span>
                  <span class="font-medium text-gray-700"><%= search.created_at.strftime("%Y-%m-%d") %></span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">Found:</span>
                  <span class="font-medium <%= last_discovery_time ? 'text-gray-700' : 'text-gray-400 italic' %>">
                    <%= last_discovery_time ? "#{time_ago_in_words(last_discovery_time).gsub('about ', '')} ago" : "never" %>
                  </span>
                </div>
              </td>

              <!-- Desktop Actions (Тепер кнопка завжди видима, без опасіті) -->
              <td class="px-6 py-3 align-top text-right whitespace-nowrap hidden md:table-cell">
                <%= button_to search_path(search),
                              method: :delete,
                              data: { confirm: 'Are you sure you want to delete this campaign?' },
                              class: "text-gray-400 hover:text-red-600 p-1 rounded transition-colors inline-block cursor-pointer",
                              title: "Delete Campaign" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 inline">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.34 6.14m-4.08 0L10 9m4.34 3.65a3 3 0 1 1-6 0M4.5 5.05h15m-13.5 0a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2m-10.5 0h10.5" />
                  </svg>
                <% end %>
              </td>

            </tr>
          <% end %>
        <% else %>
          <tr class="block md:table-row">
            <td colspan="5" class="px-6 py-16 text-center text-gray-400 text-sm block md:table-cell">
              <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z"></path></svg>
              No scraping campaigns configured yet.
              <%= link_to 'Create your first criteria', new_search_path, class: "text-indigo-600 font-semibold hover:underline ml-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>