<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4 select-none">

  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 pb-4 border-b border-breeze-border/60">
    <div>
      <h1 class="text-2xl font-bold text-breeze-text tracking-tight">Scraping Campaigns</h1>
      <p class="text-sm text-breeze-muted mt-1">Configure and monitor your automated search processes and target constraints.</p>
    </div>
    <div class="flex flex-row items-center gap-2 sm:gap-3 shrink-0 w-full sm:w-auto">
      <%= link_to categories_path, class: "flex-1 sm:flex-none text-center bg-breeze-view hover:bg-breeze-bg text-breeze-text font-medium py-2 sm:py-1.5 px-4 border border-breeze-border rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>Categories & Targets</span>
      <% end %>
      <%= link_to new_search_path, class: "flex-1 sm:flex-none text-center bg-breeze-accent hover:opacity-90 text-white font-medium py-2 sm:py-1.5 px-4 rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>New Search Criteria</span>
      <% end %>
    </div>
  </div>

  <div class="bg-breeze-view border border-breeze-border rounded-xl shadow-sm overflow-hidden">
    <table class="min-w-full table-fixed divide-y divide-breeze-border/60 block md:table">
      <thead class="bg-breeze-bg/70 text-[11px] font-bold text-breeze-muted uppercase tracking-wider text-left hidden md:table-header-group">
        <tr>
          <th class="w-4/12 px-6 py-3.5">Campaign Info & Analytics</th>
          <th class="w-4/12 px-6 py-3.5">Query & Scope</th>
          <th class="w-2/12 px-6 py-3.5">Pipeline Status</th>
          <th class="w-2/12 px-6 py-3.5">Activity</th>
          <th class="w-20 px-6 py-3.5 text-right">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-breeze-border/40 bg-breeze-view block md:table-row-group" id="searches_list">
        <% if @searches.any? %>
          <% @searches.each do |search| %>
            <% counts = search.counts_for_index(@raw_counts) %>
            <% last_action = search.updated_at %>

            <tr id="<%= dom_id(search) %>" class="hover:bg-breeze-bg/30 transition-colors group block md:table-row p-4 md:p-0 relative border-b border-breeze-border last:border-b-0 md:border-b-0">

              <td class="px-0 md:px-6 py-1 md:py-4 align-middle block md:table-cell">
                <div class="mb-2 flex justify-between items-start gap-2">
                  <%= link_to search.title, search_path(search), class: "text-base font-semibold text-breeze-text hover:text-breeze-accent transition-colors block truncate max-w-[75%] md:max-w-full", title: search.title %>

                  <div class="flex items-center gap-1 md:hidden">
                    <%= link_to edit_search_path(search), class: "text-breeze-muted hover:text-breeze-accent p-1" do %><span>⚙️</span><% end %>
                    <%= button_to search_path(search), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-breeze-muted hover:text-red-600 p-1 cursor-pointer" do %><span>🗑️</span><% end %>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
                  <div class="inline-flex items-center justify-center gap-1 bg-breeze-bg w-[60px] py-1 rounded border border-breeze-border text-breeze-muted" title="Inbox (Unread)">
                    <span class="text-[10px]">⬇️</span>
                    <span class="font-mono font-bold <%= counts[:unread].to_i > 0 ? 'text-emerald-500' : 'text-breeze-muted/60' %>"><%= counts[:unread].to_i %></span>
                  </div>
                  <div class="inline-flex items-center justify-center gap-1 bg-breeze-bg w-[60px] py-1 rounded border border-breeze-border text-breeze-muted" title="Watched">
                    <span class="text-[10px]">👁️</span>
                    <span class="font-mono font-bold <%= counts[:watched].to_i > 0 ? 'text-breeze-accent' : 'text-breeze-muted/60' %>"><%= counts[:watched].to_i %></span>
                  </div>
                  <div class="inline-flex items-center justify-center gap-1 bg-breeze-bg w-[60px] py-1 rounded border border-breeze-border text-breeze-muted" title="Starred">
                    <span class="text-[10px]">⭐</span>
                    <span class="font-mono font-bold <%= counts[:interesting].to_i > 0 ? 'text-amber-500' : 'text-breeze-muted/60' %>"><%= counts[:interesting].to_i %></span>
                  </div>
                  <div class="inline-flex items-center justify-center gap-1 bg-breeze-bg w-[60px] py-1 rounded border border-breeze-border text-breeze-muted" title="Garbage">
                    <span class="text-[10px]">🗑️</span>
                    <span class="font-mono font-bold <%= counts[:garbage].to_i > 0 ? 'text-red-400/80' : 'text-breeze-muted/40' %>"><%= counts[:garbage].to_i %></span>
                  </div>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-4 align-middle block md:table-cell">
                <div class="mb-2 max-w-full md:max-w-xs lg:max-w-sm">
                  <code class="font-mono text-[11px] text-gray-400 bg-breeze-bg/80 px-2 py-1 rounded border border-breeze-border block whitespace-normal break-words leading-relaxed">
                    <%= search.query_conditions %>
                  </code>
                </div>

                <div class="flex items-center gap-1.5 text-xs">
                  <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider text-breeze-muted bg-breeze-bg px-2 py-0.5 rounded border border-breeze-border">
                    ⏱️ <%= search.time_frame.present? ? "Past #{search.time_frame}" : "Anytime" %>
                  </span>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-4 align-middle block md:table-cell whitespace-nowrap">
                <div class="flex items-center gap-2 md:inline-block">
                  <span class="text-xs text-breeze-muted md:hidden font-medium">Status:</span>
                  <%= render "searches/status_badge", search: search %>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-4 align-middle text-[11px] text-breeze-muted block md:table-cell space-y-1.5 font-medium whitespace-nowrap">
                <div class="flex items-center gap-1">
                  <span class="text-breeze-muted/60 w-20 shrink-0">📅 Created:</span>
                  <span class="text-breeze-text font-mono"><%= search.created_at.strftime("%Y-%m-%d") %></span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-breeze-muted/60 w-20 shrink-0">🔄 Updated:</span>
                  <span class="text-breeze-text">
                    <%= last_action ? "#{time_ago_in_words(last_action).gsub('about ', '')} ago" : "Never" %>
                  </span>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-4 align-middle hidden md:table-cell text-right">
                <div class="flex items-center justify-end gap-1 w-full opacity-60 group-hover:opacity-100 transition-opacity">
                  <%= link_to edit_search_path(search), class: "text-breeze-muted hover:text-breeze-accent p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0" do %>
                    <span>⚙️</span>
                  <% end %>
                  <%= button_to search_path(search), method: :delete, data: { confirm: 'Are you sure you want to delete this campaign?' }, class: "text-breeze-muted hover:text-red-500 p-1.5 rounded transition-colors cursor-pointer bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0" do %>
                    <span>🗑️</span>
                  <% end %>
                </div>
              </td>

            </tr>
          <% end %>
        <% else %>
          <tr class="block md:table-row">
            <td colspan="5" class="px-6 py-16 text-center text-breeze-muted text-sm block md:table-cell">
              No scraping campaigns configured yet.
              <%= link_to 'Create your first criteria', new_search_path, class: "text-breeze-accent font-semibold hover:underline ml-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>