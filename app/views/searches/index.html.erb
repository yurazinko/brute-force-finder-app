<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4">

  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 pb-4 border-b border-b-gray-100">
    <div>
      <h1 class="text-2xl font-bold text-breeze-text tracking-tight">Scraping Campaigns</h1>
      <p class="text-sm text-breeze-muted mt-1">Configure and monitor your automated search processes and target constraints.</p>
    </div>
    <div class="flex flex-row items-center gap-2 sm:gap-3 shrink-0 w-full sm:w-auto">
      <%= link_to categories_path, class: "flex-1 sm:flex-none text-center bg-breeze-view hover:bg-breeze-bg text-breeze-text font-medium py-2.5 sm:py-2 px-3 sm:px-4 border border-breeze-border rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>Categories & Targets</span>
      <% end %>
      <%= link_to new_search_path, class: "flex-1 sm:flex-none text-center bg-breeze-accent hover:opacity-90 text-white font-medium py-2.5 sm:py-2 px-3 sm:px-4 rounded-lg shadow-sm transition text-xs sm:text-sm flex items-center justify-center gap-1.5" do %>
        <span>New Search Criteria</span>
      <% end %>
    </div>
  </div>

  <div class="bg-breeze-view border border-breeze-border rounded-xl shadow-sm overflow-hidden">

    <table class="min-w-full table-fixed divide-y divide-gray-200 block md:table">
      <thead class="bg-breeze-bg/70 text-xs font-semibold text-breeze-muted uppercase tracking-wider text-left hidden md:table-header-group">
        <tr>
          <th class="w-1/3 px-6 py-3.5">Campaign Info & Analytics</th>
          <th class="w-1/4 px-6 py-3.5">Query & Scope</th>
          <th class="w-1/6 px-6 py-3.5">Pipeline Status</th>
          <th class="w-1/6 px-6 py-3.5">Activity</th>
          <th class="w-20 px-6 py-3.5 text-right">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-100 bg-breeze-view block md:table-row-group" id="searches_list">
        <% if @searches.any? %>
          <% @searches.each do |search| %>
            <% last_action = search.updated_at %>
            <% unread_count      = @search_counts[[search.id, "unread"]] || 0 %>
            <% interesting_count = @search_counts[[search.id, "interesting"]] || 0 %>
            <% watched_count     = @search_counts[[search.id, "watched"]] || 0 %>
            <% garbage_count     = @search_counts[[search.id, "garbage"]] || 0 %>

            <tr id="<%= dom_id(search) %>" class="hover:bg-breeze-bg/40 transition-colors group block md:table-row p-4 md:p-0 relative border-b border-breeze-border last:border-b-0 md:border-b-0">

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell">
                <div class="mb-1.5 flex justify-between items-start gap-2">
                  <%= link_to search.title, search_path(search), class: "text-base font-semibold text-breeze-text hover:text-breeze-accent transition-colors block truncate max-w-[75%] md:max-w-full", title: search.title %>

                  <div class="flex items-center gap-1 md:hidden">
                    <%= link_to edit_search_path(search), class: "text-breeze-muted hover:text-breeze-accent p-1 rounded transition-colors", title: "Edit Campaign" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                      </svg>
                    <% end %>
                    <%= button_to search_path(search),
                                  method: :delete,
                                  data: { confirm: 'Are you sure you want to delete this campaign?' },
                                  class: "text-breeze-muted hover:text-red-600 p-1 rounded transition-colors cursor-pointer",
                                  title: "Delete Campaign" do %>
                      <span>🗑️</span>
                    <% end %>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 text-[11px] mb-3 md:mb-0">
                  <div class="inline-flex items-center gap-1 bg-breeze-bg px-2 py-0.5 rounded border border-breeze-border text-breeze-muted" title="Inbox (Unread)">
                    <span>⬇️</span>
                    <span class="font-mono font-bold <%= unread_count > 0 ? 'text-emerald-600' : 'text-breeze-muted' %>"><%= unread_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-breeze-bg px-2 py-0.5 rounded border border-breeze-border text-breeze-muted" title="Watched">
                    <span>👁️</span>
                    <span class="font-mono font-semibold <%= watched_count > 0 ? 'text-breeze-accent' : 'text-breeze-muted' %>"><%= watched_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-breeze-bg px-2 py-0.5 rounded border border-breeze-border text-breeze-muted" title="Starred">
                    <span>⭐</span>
                    <span class="font-mono font-bold <%= interesting_count > 0 ? 'text-amber-500' : 'text-breeze-muted' %>"><%= interesting_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-breeze-bg px-2 py-0.5 rounded border border-breeze-border text-breeze-muted" title="Garbage">
                    <span>🗑️</span>
                    <span class="font-mono text-breeze-muted <%= 'text-red-400 font-medium' if garbage_count > 0 %>"><%= garbage_count %></span>
                  </div>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell">
                <div class="mb-2">
                  <span class="font-mono text-[11px] text-gray-300 bg-breeze-bg px-1.5 py-0.5 rounded border border-breeze-border/60 block whitespace-normal break-all" title="<%= search.query_conditions %>">
                    <%= search.query_conditions %>
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 text-xs mb-3 md:mb-0">
                  <div class="shrink-0">
                    <% case search.time_frame %>
                    <% when 'day' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">Past 24h</span>
                    <% when 'week' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200">Past Week</span>
                    <% when 'month' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200">Past Month</span>
                    <% when 'year' %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-slate-600 bg-slate-50 px-2 py-0.5 rounded border border-slate-200">Past Year</span>
                    <% else %>
                      <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-slate-500 bg-slate-100/80 px-2 py-0.5 rounded border border-slate-200/60">Anytime</span>
                    <% end %>
                  </div>

                  <span class="text-gray-300 select-none text-[10px] hidden sm:inline">&bull;</span>

                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top block md:table-cell whitespace-nowrap md:pt-3.5 mb-3 md:mb-0">
                <div class="flex items-center gap-2 md:inline-block">
                  <span class="text-xs text-breeze-muted md:hidden font-medium">Status:</span>
                  <%= render "searches/status_badge", search: search %>
                </div>
              </td>

              <td class="px-0 md:px-6 py-1 md:py-3 align-top text-xs text-breeze-muted block md:table-cell space-y-1">
                <div class="flex items-center gap-1">
                  <span class="text-breeze-muted">Created:</span>
                  <span class="font-medium text-breeze-text"><%= search.created_at.strftime("%Y-%m-%d") %></span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-breeze-muted">Last action:</span>
                  <span class="font-medium <%= last_action ? 'text-breeze-text' : 'text-breeze-muted italic' %>">
                    <%= last_action ? "#{time_ago_in_words(last_action).gsub('about ', '')} ago" : "Never run" %>
                  </span>
                </div>
              </td>

              <td class="px-6 py-3 align-top hidden md:table-cell">
                <div class="flex items-center justify-end gap-1.5 w-full">

                  <%= link_to edit_search_path(search),
                              class: "text-breeze-muted hover:text-breeze-accent p-1.5 rounded transition-colors bg-breeze-bg hover:bg-blue-50 border border-breeze-border hover:border-blue-100 shrink-0",
                              title: "Edit Campaign Settings" do %>
                    <span>✏️</span>
                  <% end %>

                  <%= button_to search_path(search),
                                method: :delete,
                                data: { confirm: 'Are you sure you want to delete this campaign?' },
                                class: "text-breeze-muted hover:text-red-600 p-1.5 rounded transition-colors cursor-pointer bg-breeze-bg hover:bg-red-50 border border-breeze-border hover:border-red-100 shrink-0",
                                title: "Delete Campaign" do %>
                    <span>🗑️</span>
                  <% end %>

                </div>
              </td>

            </tr>
          <% end %>
        <% else %>
          <tr class="block md:table-row">
            <td colspan="5" class="px-6 py-16 text-center text-breeze-muted text-sm block md:table-cell">
              <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z"></path></svg>
              No scraping campaigns configured yet.
              <%= link_to 'Create your first criteria', new_search_path, class: "text-breeze-accent font-semibold hover:underline ml-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>