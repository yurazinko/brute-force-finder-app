<div class="max-w-7xl mx-auto px-4 py-4">

  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-2 pb-4 border-b border-gray-100">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Scraping Campaigns</h1>
      <p class="text-sm text-gray-500 mt-1">Configure and monitor your automated search processes and target constraints.</p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <%= link_to 'Categories & Targets', categories_path, class: "bg-white hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 border border-gray-200 rounded-lg shadow-sm transition text-sm flex items-center gap-2" %>
      <%= link_to 'New Search Criteria', new_search_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition text-sm flex items-center gap-2" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="min-w-full table-fixed divide-y divide-gray-200">
      <thead class="bg-gray-50/70 text-xs font-semibold text-gray-400 uppercase tracking-wider text-left">
        <tr>
          <th class="w-2/5 px-6 py-3.5">Campaign Info & Analytics</th>
          <th class="w-1/5 px-6 py-3.5">Query & Scope</th>
          <th class="w-1/6 px-6 py-3.5">Pipeline Status</th>
          <th class="w-1/6 px-6 py-3.5">Activity</th>
          <th class="w-12 px-6 py-3.5 text-right"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white" id="searches_list">
        <% if @searches.any? %>
          <% @searches.each do |search| %>
            <%- last_discovery_time = search.results.last&.created_at %>
            <%- unread_count      = @search_counts[[search.id, "unread"]] || 0 %>
            <%- interesting_count = @search_counts[[search.id, "interesting"]] || 0 %>
            <%- watched_count     = @search_counts[[search.id, "watched"]] || 0 %>
            <%- garbage_count     = @search_counts[[search.id, "garbage"]] || 0 %>

            <tr id="<%= dom_id(search) %>" class="hover:bg-gray-50/40 transition-colors group">

              <td class="px-4 py-2.5 align-top">
                <div class="mb-2">
                  <%= link_to search.title, search_path(search), class: "text-base font-semibold text-gray-900 hover:text-indigo-600 transition-colors block truncate", title: search.title %>
                </div>

                <div class="flex items-center gap-1.5 text-[11px]">
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Inbox (Unread)">
                    <span>⬇️</span>
                    <span class="font-mono font-bold <%= unread_count > 0 ? 'text-emerald-600' : 'text-gray-400' %>"><%= unread_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Starred">
                    <span>⭐</span>
                    <span class="font-mono font-bold <%= interesting_count > 0 ? 'text-amber-500' : 'text-gray-400' %>"><%= interesting_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Watched">
                    <span>👁️</span>
                    <span class="font-mono font-semibold <%= watched_count > 0 ? 'text-indigo-600' : 'text-gray-400' %>"><%= watched_count %></span>
                  </div>
                  <div class="inline-flex items-center gap-1 bg-gray-50 px-2 py-0.5 rounded border border-gray-200 text-gray-500" title="Garbage">
                    <span>🗑️</span>
                    <span class="font-mono text-gray-400 <%= 'text-red-400 font-medium' if garbage_count > 0 %>"><%= garbage_count %></span>
                  </div>
                </div>
              </td>

              <td class="px-4 py-3.5 align-top">
                <div class="mb-2 truncate max-w-full">
                  <span class="font-mono text-xs text-gray-600 bg-gray-100 px-1.5 py-0.5 rounded border border-gray-200/60 block truncate" title="<%= search.query_conditions %>">
                    <%= search.query_conditions %>
                  </span>
                </div>
                <div>
                  <% case search.time_frame %>
                  <% when 'day' %>
                    <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider text-amber-700 bg-amber-50/60 px-1.5 py-0.5 rounded border border-amber-200/50">Past 24h</span>
                  <% when 'week' %>
                    <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider text-blue-700 bg-blue-50/60 px-1.5 py-0.5 rounded border border-blue-200/50">Past Week</span>
                  <% when 'month' %>
                    <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider text-purple-700 bg-purple-50/60 px-1.5 py-0.5 rounded border border-purple-200/50">Past Month</span>
                  <% when 'year' %>
                    <span class="inline-flex items-center text-[10px] font-semibold uppercase tracking-wider text-gray-600 bg-gray-50 px-1.5 py-0.5 rounded border border-gray-200/60">Past Year</span>
                  <% else %>
                    <span class="text-xs text-gray-400 italic">Anytime scope</span>
                  <% end %>
                </div>
              </td>

              <td class="px-6 py-3.5 align-top whitespace-nowrap">
                <div class="inline-block mt-0.5">
                  <%= render "searches/status_badge", search: search %>
                </div>
              </td>

              <td class="px-6 py-3.5 align-top text-xs text-gray-500 space-y-1">
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">Created:</span>
                  <span class="font-medium text-gray-700"><%= search.created_at.strftime("%Y-%m-%d") %></span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">Found:</span>
                  <span class="font-medium <%= last_discovery_time ? 'text-gray-700' : 'text-gray-400 italic' %>">
                    <%= last_discovery_time ? "#{time_ago_in_words(last_discovery_time).gsub("about ", "")} ago" : "never" %>
                  </span>
                </div>
              </td>

              <td class="px-6 py-3.5 align-top text-right whitespace-nowrap">
                <%= button_to search_path(search),
                              method: :delete,
                              data: { confirm: 'Are you sure you want to delete this campaign?' },
                              class: "text-gray-400 hover:text-red-600 p-1 rounded transition-colors inline-block md:opacity-0 group-hover:opacity-100 cursor-pointer focus:opacity-100",
                              title: "Delete Campaign" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 inline">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.34 6.14m-4.08 0L10 9m4.34 3.65a3 3 0 1 1-6 0M4.5 5.05h15m-13.5 0a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2m-10.5 0h10.5" />
                  </svg>
                <% end %>
              </td>

            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-16 text-center text-gray-400 text-sm">
              <span class="text-2xl block mb-2">📥</span>
              No scraping campaigns configured yet.
              <%= link_to 'Create your first criteria', new_search_path, class: "text-indigo-600 font-semibold hover:underline ml-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>