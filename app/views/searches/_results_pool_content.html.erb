<div class="space-y-4" id="results_pool_list">
  <% if results.any? %>
    <% results.each do |result| %>
      <%= render "results/result_card", result: result %>
    <% end %>
  <% else %>
    <div class="text-center py-24 text-gray-400 border-2 border-dashed border-gray-200 rounded-xl bg-gray-50/30 w-full" id="empty_state">
      <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <p class="text-base font-medium text-gray-600">No matching data in this filter</p>
    </div>
  <% end %>
</div>