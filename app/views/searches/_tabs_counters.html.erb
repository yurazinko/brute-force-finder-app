<nav class="flex space-x-6 text-sm" aria-label="Tabs">
  <%= link_to search_path(search, d: params[:d], sort: params[:sort]), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status].blank? ? 'border-blue-600 text-breeze-accent font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
    ⬇️ Inbox <span id="counter_unread" class="text-[11px] px-1.5 py-0.5 bg-breeze-bg text-gray-300 rounded-full font-mono"><%= counts[:unread] || 0 %></span>
  <% end %>

  <%= link_to search_path(search, status: :watched, d: params[:d], sort: params[:sort]), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'watched' ? 'border-yellow-500 text-yellow-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
    👁 Watched <span id="counter_watched" class="text-[11px] px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded-full font-mono"><%= counts[:watched] || 0 %></span>
  <% end %>

  <%= link_to search_path(search, status: :interesting, d: params[:d], sort: params[:sort]), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'interesting' ? 'border-yellow-500 text-yellow-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
    ⭐ Interesting <span id="counter_interesting" class="text-[11px] px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded-full font-mono"><%= counts[:interesting] || 0 %></span>
  <% end %>

  <%= link_to search_path(search, status: :garbage, d: params[:d], sort: params[:sort]), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'garbage' ? 'border-red-500 text-red-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
    🗑️ Garbage <span id="counter_garbage" class="text-[11px] px-1.5 py-0.5 bg-red-50 text-red-700 rounded-full font-mono"><%= counts[:garbage] || 0 %></span>
  <% end %>
</nav>