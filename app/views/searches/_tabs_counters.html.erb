<% safe_counts = counts.with_indifferent_access %>

<div id="search_tabs_navigation" class="w-full">
  <nav class="flex space-x-6 text-sm" aria-label="Tabs">
    <%= link_to url_for(params.to_unsafe_h.merge(page: nil, status: nil)), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status].blank? ? 'border-blue-600 text-breeze-accent font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      ⬇️ Inbox <span id="counter_unread" class="text-[11px] px-1.5 py-0.5 bg-breeze-bg text-gray-300 rounded-full font-mono"><%= safe_counts[:unread] || 0 %></span>
    <% end %>

    <%= link_to url_for(params.to_unsafe_h.merge(page: nil, status: :watched)), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'watched' ? 'border-yellow-500 text-yellow-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      👁 Watched <span id="counter_watched" class="text-[11px] px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded-full font-mono"><%= safe_counts[:watched] || 0 %></span>
    <% end %>

    <%= link_to url_for(params.to_unsafe_h.merge(page: nil, status: :interesting)), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'interesting' ? 'border-yellow-500 text-yellow-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      ⭐ Interesting <span id="counter_interesting" class="text-[11px] px-1.5 py-0.5 bg-yellow-50 text-yellow-700 rounded-full font-mono"><%= safe_counts[:interesting] || 0 %></span>
    <% end %>

    <%= link_to url_for(params.to_unsafe_h.merge(page: nil, status: :garbage)), class: "pb-4 px-1 border-b-2 font-medium transition flex items-center gap-1.5 #{params[:status] == 'garbage' ? 'border-red-500 text-red-600 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      🗑️ Garbage <span id="counter_garbage" class="text-[11px] px-1.5 py-0.5 bg-red-50 text-red-700 rounded-full font-mono"><%= safe_counts[:garbage] || 0 %></span>
    <% end %>
  </nav>
</div>