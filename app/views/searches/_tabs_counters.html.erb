<%
  safe_counts = counts

  clean_params = params.to_unsafe_h.except(:controller, :action, :id, :_method, :authenticity_token, :path).symbolize_keys

  if search.present?
    base_route_helper = :search_path
    route_target = search
  else
    base_route_helper = :results_path
    route_target = nil
  end

  active_status = params[:status].to_s
%>

<div id="search_tabs_navigation" class="w-full">
  <nav class="flex space-x-2 sm:space-x-6 text-xs sm:text-sm" aria-label="Tabs">

    <%= link_to send(base_route_helper, route_target, clean_params.merge(page: nil, status: nil)),
                class: "pb-3.5 px-1 sm:px-2 border-b-2 font-semibold transition-all flex items-center gap-2 #{active_status.blank? ? 'border-breeze-accent text-breeze-accent font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      <span>📥</span>
      <span>Inbox</span>
      <span id="counter_unread"
            class="text-[11px] px-2 py-0.5 rounded-full font-mono font-bold transition-colors <%= active_status.blank? ? 'bg-breeze-accent/20 text-breeze-accent border border-breeze-accent/30' : 'bg-breeze-bg text-breeze-muted border border-breeze-border/60' %>">
        <%= safe_counts[:unread] || 0 %>
      </span>
    <% end %>

    <%= link_to send(base_route_helper, route_target, clean_params.merge(page: nil, status: :watched)),
                class: "pb-3.5 px-1 sm:px-2 border-b-2 font-semibold transition-all flex items-center gap-2 #{active_status == 'watched' ? 'border-sky-400 text-sky-400 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      <span>👁️</span>
      <span>Reviewed</span>
      <span id="counter_watched"
            class="text-[11px] px-2 py-0.5 rounded-full font-mono font-bold transition-colors <%= active_status == 'watched' ? 'bg-sky-500/20 text-sky-300 border border-sky-500/30' : 'bg-breeze-bg text-breeze-muted border border-breeze-border/60' %>">
        <%= safe_counts[:watched] || 0 %>
      </span>
    <% end %>

    <%= link_to send(base_route_helper, route_target, clean_params.merge(page: nil, status: :interesting)),
                class: "pb-3.5 px-1 sm:px-2 border-b-2 font-semibold transition-all flex items-center gap-2 #{active_status == 'interesting' ? 'border-amber-400 text-amber-300 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      <span>⭐</span>
      <span>Starred</span>
      <span id="counter_interesting"
            class="text-[11px] px-2 py-0.5 rounded-full font-mono font-bold transition-colors <%= active_status == 'interesting' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-breeze-bg text-breeze-muted border border-breeze-border/60' %>">
        <%= safe_counts[:interesting] || 0 %>
      </span>
    <% end %>

    <%= link_to send(base_route_helper, route_target, clean_params.merge(page: nil, status: :garbage)),
                class: "pb-3.5 px-1 sm:px-2 border-b-2 font-semibold transition-all flex items-center gap-2 #{active_status == 'garbage' ? 'border-red-500 text-red-400 font-bold' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:border-breeze-border'}" do %>
      <span>🗑️</span>
      <span>Trash</span>
      <span id="counter_garbage"
            class="text-[11px] px-2 py-0.5 rounded-full font-mono font-bold transition-colors <%= active_status == 'garbage' ? 'bg-red-500/20 text-red-300 border border-red-500/30' : 'bg-breeze-bg text-breeze-muted border border-breeze-border/60' %>">
        <%= safe_counts[:garbage] || 0 %>
      </span>
    <% end %>

  </nav>
</div>