<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to '← Back to List', searches_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
    <h1 class="text-3xl font-bold text-gray-900 mt-2">Create New Search Campaign</h1>
  </div>

  <%= form_with(model: @search, class: "space-y-6 bg-white p-6 shadow border border-gray-200 rounded-xl") do |f| %>
    <% if @search.errors.any? %>
      <div class="bg-red-50 p-4 rounded-lg text-red-700 text-sm">
        <h2 class="font-bold mb-2"><%= pluralize(@search.errors.count, "error") %> prohibited this search from being saved:</h2>
        <ul class="list-disc pl-5">
          <% @search.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :title, "Search Campaign Title", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :title, placeholder: "e.g., Elixir Remote Backend Jobs", class: "w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2" %>
      </div>

      <div>
        <%= f.label :query_conditions, "Google Dork Conditions (Raw)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :query_conditions, placeholder: "e.g., (elixir OR phoenix) \"remote\"", class: "w-full font-mono text-sm rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2" %>
        <p class="mt-1 text-xs text-gray-400">This string will be combined with target domains auto-magically.</p>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-6">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Link Target Websites</h2>
          <p class="text-xs text-gray-500">Select which websites this campaign will monitor.</p>
        </div>
        <div class="flex space-x-2 text-xs font-medium">
          <button type="button" onclick="toggleGlobalTargets(true)" class="text-blue-600 hover:underline cursor-pointer">Select Absolutely All</button>
          <span class="text-gray-300">|</span>
          <button type="button" onclick="toggleGlobalTargets(false)" class="text-gray-500 hover:underline cursor-pointer">Clear All</button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="categories_selector_root">
        <% Category.includes(:targets).order(:name).each do |category| %>
          <% active_targets = category.targets.active %>
          <% next if active_targets.empty? %>

          <div class="category-card-group border border-gray-200 rounded-xl p-4 bg-gray-50/50 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-center mb-3 pb-1 border-b border-gray-200">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider"><%= category.name %></h3>

                <button type="button"
                        onclick="toggleCategoryGroup(this)"
                        data-status="false"
                        class="category-bulk-btn text-[11px] bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 px-2 py-0.5 rounded shadow-sm font-medium transition cursor-pointer">
                  Select All Group
                </button>
              </div>

              <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
                <% active_targets.order(:name).each do |target| %>
                  <label class="flex items-start space-x-3 py-1 px-1.5 rounded hover:bg-white cursor-pointer transition text-sm">
                    <%= check_box_tag "search[target_ids][]", target.id, false, class: "target-item-checkbox mt-0.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer" %>
                    <div class="leading-tight">
                      <span class="text-gray-800 font-medium"><%= target.name %></span>
                      <span class="text-[11px] text-gray-400 block font-mono"><%= target.domain %></span>
                    </div>
                  </label>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-4 flex justify-end space-x-3">
      <%= link_to 'Cancel', searches_path, class: "py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 cursor-pointer" %>
      <%= f.submit "Save Criteria", class: "py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
  // Функція для кнопки "Влупити всі з цієї категорії"
  function toggleCategoryGroup(button) {
    const card = button.closest('.category-card-group');
    const checkboxes = card.querySelectorAll('.target-item-checkbox');
    const isChecked = button.getAttribute('data-status') === 'true';

    checkboxes.forEach(cb => cb.checked = !isChecked);

    if (!isChecked) {
      button.setAttribute('data-status', 'true');
      button.innerText = 'Clear Group';
      button.className = 'category-bulk-btn text-[11px] bg-gray-200 border border-gray-400 text-gray-800 px-2 py-0.5 rounded shadow-inner font-medium transition cursor-pointer';
    } else {
      button.setAttribute('data-status', 'false');
      button.innerText = 'Select All Group';
      button.className = 'category-bulk-btn text-[11px] bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 px-2 py-0.5 rounded shadow-sm font-medium transition cursor-pointer';
    }
  }

  // Глобальний вибір "Виділити взагалі все" або "Очистити все"
  function toggleGlobalTargets(status) {
    document.querySelectorAll('.target-item-checkbox').forEach(cb => cb.checked = status);
    document.querySelectorAll('.category-bulk-btn').forEach(button => {
      button.setAttribute('data-status', status.toString());
      button.innerText = status ? 'Clear Group' : 'Select All Group';
      button.className = status
        ? 'category-bulk-btn text-[11px] bg-gray-200 border border-gray-400 text-gray-800 px-2 py-0.5 rounded shadow-inner font-medium transition cursor-pointer'
        : 'category-bulk-btn text-[11px] bg-white border border-gray-300 text-gray-700 hover:bg-gray-100 px-2 py-0.5 rounded shadow-sm font-medium transition cursor-pointer';
    });
  }
</script>