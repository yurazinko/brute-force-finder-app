<div id="search_live_tracker" class="w-full flex items-center gap-2 min-w-0">
  <span class="flex h-1.5 w-1.5 relative shrink-0">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-breeze-accent opacity-75"></span>
    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-breeze-accent"></span>
  </span>

  <span id="live_tracker_message" class="truncate w-full text-gray-400 font-mono text-[12px] antialiased tracking-wide" title="<%= message %>">
    <%= message %>
  </span>
</div>