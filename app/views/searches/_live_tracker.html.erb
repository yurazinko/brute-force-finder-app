<div id="search_live_tracker" class="w-full text-xs bg-slate-900 text-slate-200 font-mono px-3 py-2 rounded-lg shadow-inner flex items-center gap-2 border border-slate-800">
  <span class="flex h-2 w-2 relative shrink-0">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
  </span>

  <span id="live_tracker_message" class="truncate w-full" title="<%= message %>"><%= message %></span>
</div>