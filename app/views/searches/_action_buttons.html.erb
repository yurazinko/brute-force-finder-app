<% compact = local_assigns.fetch(:compact, false) %>
<% action_buttons_id = compact ? "#{dom_id(search)}_action_buttons_compact" : "#{dom_id(search)}_action_buttons" %>

<div id="<%= action_buttons_id %>" class="flex items-center <%= compact ? 'gap-1' : 'gap-2' %>">
  <% if search.paused? %>
    <%= button_to toggle_pause_search_path(search),
                  method: :patch,
                  title: "Resume Campaign",
                  class: compact ? "text-breeze-muted hover:text-emerald-500 p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer"
                                 : "text-xs font-semibold text-emerald-600 hover:text-white bg-emerald-50 hover:bg-emerald-600 border border-emerald-100 hover:border-emerald-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
      <span>▶️</span>
      <% unless compact %><span class="hidden sm:inline">Resume</span><% end %>
    <% end %>
  <% else %>
    <%= button_to toggle_pause_search_path(search),
                  method: :patch,
                  title: "Pause Campaign",
                  class: compact ? "text-breeze-muted hover:text-amber-500 p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer"
                                 : "text-xs font-semibold text-amber-600 hover:text-white bg-amber-50 hover:bg-amber-600 border border-amber-100 hover:border-amber-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
      <span>⏸️</span>
      <% unless compact %><span class="hidden sm:inline">Pause</span><% end %>
    <% end %>
  <% end %>

<%= button_to complete_search_path(search),
                method: :patch,
                form: { data: { confirm: search.status == "processing" ? 'Force complete this campaign?' : nil } },
                disabled: search.status != "processing",
                title: "Force Complete Campaign",
                class: (compact ? "text-breeze-muted enabled:hover:text-purple-500 p-1.5 rounded transition-colors bg-breeze-bg enabled:hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-breeze-bg"
                                : "text-xs font-semibold text-purple-600 enabled:hover:text-white bg-purple-50 enabled:hover:bg-purple-600 border border-purple-100 enabled:hover:border-purple-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-purple-50 disabled:hover:text-purple-600 disabled:border-purple-100 disabled:shadow-none") do %>
      <span>✅</span>
      <% unless compact %><span class="hidden sm:inline">Complete</span><% end %>
  <% end %>

  <%= link_to edit_search_path(search),
              title: "Configure Campaign",
              class: compact ? "text-breeze-muted hover:text-breeze-accent p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0"
                             : "text-xs font-semibold text-breeze-accent hover:text-white bg-blue-50 hover:bg-blue-600 border border-blue-100 hover:border-blue-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 shadow-sm" do %>
    <span>⚙️</span>
    <% unless compact %><span class="hidden sm:inline">Configure</span><% end %>
  <% end %>

  <%= button_to search_path(search),
                method: :delete,
                data: { confirm: 'Are you sure you want to completely delete this campaign and all its results?' },
                title: "Delete Campaign",
                class: compact ? "text-breeze-muted hover:text-red-500 p-1.5 rounded transition-colors cursor-pointer bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0"
                               : "text-xs font-semibold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 border border-red-100 hover:border-red-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
    <span>🗑️</span>
    <% unless compact %><span class="hidden sm:inline">Delete</span><% end %>
  <% end %>
</div>