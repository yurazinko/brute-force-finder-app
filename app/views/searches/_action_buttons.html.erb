<% compact = local_assigns.fetch(:compact, false) %>
<% action_buttons_id = compact ? "#{dom_id(search)}_action_buttons_compact" : "#{dom_id(search)}_action_buttons" %>

<div id="<%= action_buttons_id %>" class="flex items-center <%= compact ? 'gap-1' : 'gap-1.5 sm:gap-2' %>">
  <% if search.paused? %>
    <%= button_to toggle_pause_search_path(search),
                  method: :patch,
                  title: "Resume Campaign Scans",
                  class: compact ? "text-breeze-muted hover:text-emerald-400 p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer"
                                 : "text-xs font-semibold text-emerald-400 hover:text-white bg-emerald-500/10 hover:bg-emerald-600 border border-emerald-500/20 hover:border-emerald-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
      <span>▶️</span>
      <% unless compact %><span class="hidden sm:inline">Resume</span><% end %>
    <% end %>
  <% else %>
    <%= button_to toggle_pause_search_path(search),
                  method: :patch,
                  title: "Pause Automated Scans",
                  class: compact ? "text-breeze-muted hover:text-amber-400 p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer"
                                 : "text-xs font-semibold text-amber-400 hover:text-white bg-amber-500/10 hover:bg-amber-600 border border-amber-500/20 hover:border-amber-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm" do %>
      <span>⏸️</span>
      <% unless compact %><span class="hidden sm:inline">Pause</span><% end %>
    <% end %>
  <% end %>

  <%= button_to complete_search_path(search),
                method: :patch,
                form: { data: { turbo_confirm: search.status == "processing" ? 'Mark campaign scan as complete?' : nil } },
                disabled: search.status != "processing",
                title: "Stop and Mark Complete",
                class: (compact ? "text-breeze-muted enabled:hover:text-purple-400 p-1.5 rounded transition-colors bg-breeze-bg enabled:hover:bg-breeze-border/40 border border-breeze-border shrink-0 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-breeze-bg"
                                : "text-xs font-semibold text-purple-400 enabled:hover:text-white bg-purple-500/10 enabled:hover:bg-purple-600 border border-purple-500/20 enabled:hover:border-purple-600 px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer shadow-sm disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-purple-500/10 disabled:hover:text-purple-400 disabled:border-purple-500/20 disabled:shadow-none") do %>
      <span>✅</span>
      <% unless compact %><span class="hidden sm:inline">Complete</span><% end %>
  <% end %>

  <div class="h-4 border-l border-breeze-border/60 mx-0.5 hidden sm:block"></div>

  <%= link_to edit_search_path(search),
              title: "Configure Campaign",
              class: compact ? "text-breeze-muted hover:text-breeze-accent p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0"
                             : "text-xs font-semibold text-breeze-muted hover:text-breeze-text bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1 shadow-sm" do %>
    <span>⚙️</span>
    <% unless compact %><span class="hidden sm:inline">Edit</span><% end %>
  <% end %>

  <%= link_to new_search_path(clone_from: search.id),
              title: "Clone Campaign Settings",
              class: compact ? "text-breeze-muted hover:text-breeze-accent p-1.5 rounded transition-colors bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0"
                            : "text-xs font-semibold text-breeze-muted hover:text-breeze-text bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1 shadow-sm" do %>
    <span>🐑</span>
    <% unless compact %><span class="hidden sm:inline">Clone</span><% end %>
  <% end %>

  <%= button_to search_path(search),
                method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this campaign and clear all discovered results?" },
                title: "Delete Campaign",
                class: compact ? "text-breeze-muted hover:text-red-400 p-1.5 rounded transition-colors cursor-pointer bg-breeze-bg hover:bg-breeze-border/40 border border-breeze-border shrink-0"
                               : "text-xs font-semibold text-red-400 hover:text-white bg-red-500/10 hover:bg-red-600 border border-red-500/20 hover:border-red-600 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1 cursor-pointer shadow-sm" do %>
    <span>🗑️</span>
    <% unless compact %><span class="hidden sm:inline">Delete</span><% end %>
  <% end %>
</div>