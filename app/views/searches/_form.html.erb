<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-6">

  <!-- Header & Back Link -->
  <div>
    <%= link_to back_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition shrink-0 bg-breeze-bg/50 px-2.5 py-1 rounded-md border border-breeze-border/60 mb-3" do %>
      <span>←</span>
      <span><%= back_label %></span>
    <% end %>
    <h1 class="text-xl sm:text-2xl font-bold text-breeze-text flex items-center gap-2">
      <span>🚀</span>
      <span><%= title %></span>
    </h1>
  </div>

  <!-- Form Component -->
  <%= form_with(model: search, data: { turbo: false }, class: "space-y-6 bg-breeze-view p-4 sm:p-6 shadow-xs border border-breeze-border/80 rounded-xl") do |f| %>

    <!-- Validation Errors Block -->
    <% if search.errors.any? %>
      <div class="bg-red-500/10 border border-red-500/30 p-4 rounded-lg text-red-400 text-xs space-y-1">
        <h2 class="font-bold text-sm flex items-center gap-1.5">
          <span>⚠️</span>
          <span><%= pluralize(search.errors.count, "error") %> prohibited saving campaign:</span>
        </h2>
        <ul class="list-disc pl-5 font-mono space-y-0.5 text-red-300">
          <% search.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Section 1: General Settings -->
    <div class="bg-breeze-bg/40 p-4 sm:p-5 rounded-xl border border-breeze-border/60 space-y-4">
      <div class="border-b border-breeze-border/40 pb-2">
        <h2 class="text-xs font-bold text-breeze-accent uppercase tracking-wider flex items-center gap-1.5">
          <span>1️⃣</span>
          <span>General Campaign Settings</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <div>
          <%= f.label :title, "Campaign Title", class: "block text-xs font-semibold text-breeze-text mb-1" %>
          <%= f.text_field :title, placeholder: "e.g., Elixir Remote Backend Jobs", class: "w-full text-xs sm:text-sm bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border p-2.5 focus:border-breeze-accent focus:ring-1 focus:ring-breeze-accent outline-none placeholder:text-breeze-muted/50 transition-all" %>
        </div>

        <div>
          <%= f.label :time_frame, "Engine Time Filter", class: "block text-xs font-semibold text-breeze-text mb-1" %>
          <%= f.select :time_frame,
                       [
                         ['Anytime (No filter)', nil],
                         ['Past 24 Hours', 'day'],
                         ['Past Week', 'week'],
                         ['Past Month', 'month'],
                         ['Past Year', 'year']
                       ],
                       {},
                       { class: "w-full text-xs sm:text-sm bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border p-2.5 focus:border-breeze-accent focus:ring-1 focus:ring-breeze-accent outline-none cursor-pointer transition-all" } %>
        </div>
      </div>

      <div class="pt-3 border-t border-breeze-border/40 flex items-start gap-3">
        <%= f.check_box :show_acknowledged, class: "mt-0.5 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer h-4 w-4" %>
        <div class="text-xs">
          <%= f.label :show_acknowledged, "Show globally processed results", class: "font-semibold text-breeze-text cursor-pointer block" %>
          <p class="text-[11px] text-breeze-muted/80 mt-0.5">
            If unchecked, leads already marked as Trash, Starred, or Watched in other campaigns will be automatically hidden from this inbox.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 2: Dork Builder -->
    <div class="border-t border-breeze-border/60 pt-5 space-y-3">
      <div>
        <h2 class="text-xs font-bold text-breeze-accent uppercase tracking-wider flex items-center gap-1.5">
          <span>2️⃣</span>
          <span>Dork Query Configuration</span>
        </h2>
        <p class="text-xs text-breeze-muted mt-0.5">Define query conditions or switch to raw mode to write a custom search string.</p>
      </div>
      <%= render 'dork_builder', initial_value: search.query_conditions, input_name: 'search[query_conditions]' %>
    </div>

    <!-- Section 3: Target Websites Selector -->
    <% if @categories.present? %>
      <div class="border-t border-breeze-border/60 pt-5 space-y-4" data-controller="targets-selector">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-breeze-border/40 pb-2">
          <div>
            <h2 class="text-xs font-bold text-breeze-accent uppercase tracking-wider flex items-center gap-1.5">
              <span>3️⃣</span>
              <span>Linked Target Websites</span>
            </h2>
            <p class="text-xs text-breeze-muted mt-0.5">Select which search portals and domains this campaign will monitor.</p>
          </div>

          <div class="flex items-center space-x-2 text-xs font-medium">
            <button type="button"
                    data-action="click->targets-selector#toggleGlobal"
                    data-targets-selector-status-param="true"
                    class="text-breeze-accent hover:underline px-2 py-1 rounded bg-breeze-accent/10 border border-breeze-accent/20 cursor-pointer transition">
              Select All Portals
            </button>
            <span class="text-breeze-border/60">|</span>
            <button type="button"
                    data-action="click->targets-selector#toggleGlobal"
                    data-targets-selector-status-param="false"
                    class="text-breeze-muted hover:text-breeze-text px-2 py-1 rounded bg-breeze-bg border border-breeze-border/60 cursor-pointer transition">
              Clear All
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="categories_selector_root">
          <% @categories.each do |category| %>
            <% active_targets = category.active_targets %>
            <% next if active_targets.empty? %>

            <div data-targets-selector-target="group" class="category-card-group border border-breeze-border/80 rounded-xl p-4 bg-breeze-bg/40 flex flex-col justify-between hover:border-breeze-border transition-all">
              <div>
                <div class="flex justify-between items-center mb-3 pb-2 border-b border-breeze-border/60">
                  <h3 class="text-xs font-bold text-breeze-text uppercase tracking-wider"><%= category.name %></h3>
                  <button type="button"
                          data-targets-selector-target="groupButton"
                          data-action="click->targets-selector#toggleGroup"
                          data-status="false"
                          class="category-bulk-btn text-[10px] font-mono bg-breeze-view border border-breeze-border text-breeze-muted hover:text-breeze-text hover:bg-breeze-border/40 px-2 py-0.5 rounded font-medium transition cursor-pointer">
                    Toggle Category
                  </button>
                </div>

                <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
                  <% active_targets.each do |target| %>
                    <label class="flex items-start space-x-2.5 p-1.5 rounded hover:bg-breeze-view cursor-pointer transition text-xs border border-transparent hover:border-breeze-border/40">
                      <%= check_box_tag "search[target_ids][]", target.id, search.target_ids.include?(target.id),
                                        class: "target-item-checkbox mt-0.5 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer h-3.5 w-3.5",
                                        data: { targets_selector_target: "checkbox" } %>
                      <div class="leading-tight min-w-0 flex-1">
                        <span class="text-breeze-text font-medium truncate block"><%= target.name %></span>
                        <span class="text-[10px] text-breeze-muted font-mono truncate block"><%= target.domain %></span>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Form Actions Footer -->
    <div class="border-t border-breeze-border/60 pt-4 flex items-center justify-end space-x-3">
      <%= link_to 'Cancel', back_path, class: "py-2 px-4 border border-breeze-border/80 rounded-lg text-xs font-semibold text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60 transition cursor-pointer" %>
      <%= f.submit submit_label, class: "py-2 px-5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-sm hover:shadow transition-all cursor-pointer border border-blue-400/20" %>
    </div>

  <% end %>

</div>