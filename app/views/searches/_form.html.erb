<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4 sm:space-y-6">
  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl">
    <%= link_to back_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition-colors bg-breeze-bg/60 hover:bg-breeze-bg px-2.5 py-1.5 rounded-lg border border-breeze-border/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent/60 mb-3" do %>
      <span><%= back_label %></span>
    <% end %>
    <h1 class="text-xl sm:text-2xl font-bold text-breeze-text tracking-tight"><%= title %></h1>
    <p class="text-xs sm:text-sm text-breeze-muted mt-1">Define the search query, time range, and target websites for this campaign.</p>
  </div>

  <%= form_with(model: search, data: { turbo: false }, class: "space-y-5 sm:space-y-6 bg-breeze-view p-4 sm:p-6 border border-breeze-border rounded-xl shadow-sm") do |f| %>

    <% if search.errors.any? %>
      <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300" role="alert" aria-live="polite">
        <h2 class="flex items-start gap-2 font-semibold text-red-200">
          <span aria-hidden="true">⚠️</span>
          <span><%= pluralize(search.errors.count, "error") %> prevented this campaign from being saved:</span>
        </h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs sm:text-sm">
          <% search.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-xl border border-breeze-border/70 bg-breeze-bg/35 p-4 sm:p-5 space-y-4">
      <div class="flex items-center gap-2.5 border-b border-breeze-border/50 pb-3">
        <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-breeze-accent/25 bg-breeze-accent/10 font-mono text-[10px] font-bold text-breeze-accent">01</span>
        <h2 class="text-sm sm:text-base font-semibold text-breeze-text">General Campaign Settings</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <div class="min-w-0">
          <%= f.label :title, "Campaign Title", class: "mb-1.5 block text-xs font-semibold text-breeze-text" %>
          <%= f.text_field :title, placeholder: "e.g., Elixir Remote Backend Jobs", class: "w-full min-h-10 rounded-lg border border-breeze-border bg-breeze-bg px-3 py-2.5 text-sm text-breeze-text placeholder:text-breeze-muted/50 transition-colors focus:border-breeze-accent focus:outline-none focus:ring-2 focus:ring-breeze-accent/30" %>
        </div>

        <div class="min-w-0">
          <%= f.label :time_frame, "Engine Time Filter", class: "mb-1.5 block text-xs font-semibold text-breeze-text" %>
          <%= f.select :time_frame,
                       [
                         ['Anytime (No filter)', nil],
                         ['Past 24 Hours', 'day'],
                         ['Past Week', 'week'],
                         ['Past Month', 'month'],
                         ['Past Year', 'year']
                       ],
                       {},
                       { class: "w-full min-h-10 cursor-pointer rounded-lg border border-breeze-border bg-breeze-bg px-3 py-2.5 text-sm text-breeze-text transition-colors focus:border-breeze-accent focus:outline-none focus:ring-2 focus:ring-breeze-accent/30" } %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <div class="min-w-0">
          <%= f.label :relevance_mode, "Relevance Rule", class: "mb-1.5 block text-xs font-semibold text-breeze-text" %>
          <%= f.select :relevance_mode,
                       [
                         ['Strict (Every keyword group must match)', 'strict'],
                         ['Balanced (Primary + at least one supporting group)', 'balanced']
                       ],
                       {},
                       { class: "w-full min-h-10 cursor-pointer rounded-lg border border-breeze-border bg-breeze-bg px-3 py-2.5 text-sm text-breeze-text transition-colors focus:border-breeze-accent focus:outline-none focus:ring-2 focus:ring-breeze-accent/30" } %>
          <p class="mt-1.5 text-[11px] leading-relaxed text-breeze-muted">
            Strict requires every group to match. Balanced requires the primary group and at least one supporting group (for a single-group query, the primary group is sufficient). Each group contributes equally to the percentage score; missing the primary group applies a penalty.
          </p>
        </div>
      </div>

      <label class="flex items-start gap-3 rounded-lg border border-breeze-border/50 bg-breeze-view/50 p-3.5 cursor-pointer transition-colors hover:border-breeze-border hover:bg-breeze-view">
        <%= f.check_box :show_acknowledged, class: "mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-2 focus:ring-breeze-accent/40" %>
        <span class="min-w-0">
          <span class="block text-xs font-semibold text-breeze-text">Show globally processed results</span>
          <span class="mt-1 block text-[11px] leading-relaxed text-breeze-muted">When enabled, this inbox also shows leads already marked as Trash, Starred, or Watched in other campaigns.</span>
        </span>
      </label>
    </div>

    <div class="rounded-xl border border-breeze-border/70 bg-breeze-bg/35 p-4 sm:p-5 space-y-4">
      <div class="flex items-start gap-2.5 border-b border-breeze-border/50 pb-3">
        <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-breeze-accent/25 bg-breeze-accent/10 font-mono text-[10px] font-bold text-breeze-accent">02</span>
        <div class="min-w-0">
          <h2 class="text-sm sm:text-base font-semibold text-breeze-text">Dork Query Configuration</h2>
          <p class="mt-1 text-xs leading-relaxed text-breeze-muted">Define query conditions or switch to raw mode to write a custom search string.</p>
        </div>
      </div>
      <%= render 'dork_builder', initial_value: search.query_conditions, input_name: 'search[query_conditions]' %>
    </div>

    <% if @categories.present? %>
      <div class="rounded-xl border border-breeze-border/70 bg-breeze-bg/35 p-4 sm:p-5 space-y-4" data-controller="targets-selector">
        <div class="flex flex-col gap-3 border-b border-breeze-border/50 pb-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 items-start gap-2.5">
            <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-breeze-accent/25 bg-breeze-accent/10 font-mono text-[10px] font-bold text-breeze-accent">03</span>
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-semibold text-breeze-text">Linked Target Websites</h2>
              <p class="mt-1 text-xs leading-relaxed text-breeze-muted">Select which search portals and domains this campaign will monitor.</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pl-8 sm:pl-0">
            <button type="button"
                    data-action="click->targets-selector#toggleGlobal"
                    data-targets-selector-status-param="true"
                    class="inline-flex min-h-8 items-center justify-center rounded-lg border border-breeze-accent/25 bg-breeze-accent/10 px-3 py-1.5 text-[11px] font-semibold text-breeze-accent transition-colors hover:bg-breeze-accent/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent/50 cursor-pointer">
              Select All
            </button>
            <button type="button"
                    data-action="click->targets-selector#toggleGlobal"
                    data-targets-selector-status-param="false"
                    class="inline-flex min-h-8 items-center justify-center rounded-lg border border-breeze-border bg-breeze-view px-3 py-1.5 text-[11px] font-semibold text-breeze-muted transition-colors hover:bg-breeze-bg hover:text-breeze-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent/50 cursor-pointer">
              Clear All
            </button>
          </div>
        </div>

        <%= hidden_field_tag "search[target_ids][]", "" %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" id="categories_selector_root">
          <% @categories.each do |category| %>
            <% active_targets = category.active_targets %>
            <% next if active_targets.empty? %>

            <div data-targets-selector-target="group" class="category-card-group flex min-w-0 flex-col rounded-xl border border-breeze-border/70 bg-breeze-view/60 p-3.5 transition-colors hover:border-breeze-accent/40">
              <div class="mb-2.5 flex items-center justify-between gap-2 border-b border-breeze-border/50 pb-2.5">
                <h3 class="min-w-0 truncate text-xs font-semibold text-breeze-text" title="<%= category.name %>"><%= category.name %></h3>
                <button type="button"
                        data-targets-selector-target="groupButton"
                        data-action="click->targets-selector#toggleGroup"
                        data-status="false"
                        class="category-bulk-btn shrink-0 rounded-md border border-breeze-border bg-breeze-bg px-2 py-1 text-[10px] font-medium text-breeze-muted transition-colors hover:bg-breeze-border/30 hover:text-breeze-text cursor-pointer">
                  Toggle Category
                </button>
              </div>

              <div class="max-h-48 space-y-1 overflow-y-auto pr-1">
                <% active_targets.each do |target| %>
                  <label class="flex min-w-0 items-start gap-2.5 rounded-lg border border-transparent px-2 py-2 text-xs transition-colors hover:border-breeze-border/50 hover:bg-breeze-bg/60 cursor-pointer">
                    <%= check_box_tag "search[target_ids][]", target.id, search.target_ids.include?(target.id),
                                      class: "target-item-checkbox mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-2 focus:ring-breeze-accent/40",
                                      data: { targets_selector_target: "checkbox" } %>
                    <span class="min-w-0 flex-1 leading-snug">
                      <span class="block truncate font-medium text-breeze-text"><%= target.name %></span>
                      <span class="mt-0.5 block truncate font-mono text-[10px] text-breeze-muted" title="<%= target.domain %>"><%= target.domain %></span>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="border-t border-breeze-border/50 pt-3">
          <%= link_to categories_path, class: "inline-flex min-h-9 items-center gap-2 rounded-lg border border-breeze-border bg-breeze-view px-3 py-2 text-xs font-semibold text-breeze-muted transition-colors hover:border-breeze-accent/30 hover:bg-breeze-bg hover:text-breeze-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent/50" do %>
            <span aria-hidden="true">⚙️</span>
            <span>Manage Target Websites</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col gap-2 border-t border-breeze-border/60 pt-4 sm:flex-row sm:items-center sm:justify-end sm:gap-3">
      <%= link_to 'Cancel', back_path, class: "inline-flex min-h-10 w-full items-center justify-center rounded-lg border border-breeze-border bg-breeze-bg/60 px-4 py-2 text-xs font-semibold text-breeze-muted transition-colors hover:bg-breeze-bg hover:text-breeze-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent/50 sm:w-auto" %>
      <%= f.submit submit_label, class: "inline-flex min-h-10 w-full cursor-pointer items-center justify-center rounded-lg border border-blue-400/20 bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-2 text-xs font-bold text-white shadow-sm transition-all hover:from-blue-500 hover:to-indigo-500 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400/60 focus-visible:ring-offset-2 focus-visible:ring-offset-breeze-view sm:w-auto" %>
    </div>
  <% end %>
</div>
