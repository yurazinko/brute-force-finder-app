<div class="col-span-1 sm:col-span-12 flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full min-w-0">
  <!-- Status Badge with Fixed Width Wrapper -->
  <div class="flex items-center gap-1.5 shrink-0 h-8 px-1">
    <span class="text-breeze-muted font-semibold text-[10px] uppercase tracking-wider shrink-0">
      Status:
    </span>
    <!-- w-28 гарантує однакову ширину для будь-яких слів (Completed, Processing, etc.) -->
    <div class="flex items-center shrink-0 w-28 justify-start">
      <%= render "searches/status_badge", search: search %>
    </div>
  </div>

  <!-- Live Tracker Box -->
  <div class="flex-1 min-w-0 w-full">
    <div id="search_live_tracker" class="flex items-center gap-2 bg-black/80 border border-emerald-500/30 rounded-md h-8 px-2.5 font-mono text-[11px] shadow-inner w-full min-w-0 overflow-hidden select-none">

      <!-- Indicator -->
      <span class="flex h-1.5 w-1.5 relative shrink-0">
        <% if search.status == 'processing' %>
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
        <% else %>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-gray-600"></span>
        <% end %>
      </span>

      <!-- Console Text Wrapper -->
      <div class="relative flex-1 min-w-0 h-full flex items-center overflow-hidden">
        <div class="absolute inset-0 flex items-center overflow-hidden">
          <div id="live_tracker_message" class="whitespace-nowrap animate-marquee hover:[animation-play-state:paused] text-emerald-400/90 tracking-tight after:content-['█'] after:animate-ping after:ml-1 after:text-emerald-500">
            <% case search.status %>
            <% when "processing" %>
              Scanning targeted web sources in real-time stream...
            <% when "paused" %>
              Automated web scans are temporarily suspended.
            <% when "completed" %>
              All active sources processed. Waiting for next cycle...
            <% else %>
              Awaiting discovery signal to begin...
            <% end %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>