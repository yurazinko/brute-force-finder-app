<div class="sm:col-span-3 flex items-center gap-2.5 min-w-0 h-9 px-1">
  <span class="text-breeze-muted font-semibold text-[11px] uppercase tracking-wider shrink-0">Pipeline:</span>
  <div class="flex items-center min-w-0 truncate">
    <%= render "searches/status_badge", search: search %>
  </div>
</div>

<div class="sm:col-span-9 w-full min-w-0">
  <div id="search_live_tracker" class="flex items-center gap-2 bg-black/40 border border-breeze-border/40 rounded-lg h-9 px-3 font-mono text-xs text-gray-300 shadow-inner w-full min-w-0">

    <span class="flex h-1.5 w-1.5 relative shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-breeze-accent opacity-75"></span>
      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-breeze-accent"></span>
    </span>

    <span id="live_tracker_message" class="truncate flex-1 text-gray-400 text-[12px]" title="<%= search.status == 'processing' ? 'Scraper engine is busy...' : 'Waiting for scraper engine...' %>">
      <%= search.status == "processing" ? "Scraper engine is busy..." : "Waiting for scraper engine..." %>
    </span>
  </div>
</div>