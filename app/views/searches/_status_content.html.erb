<div class="sm:col-span-3 flex items-center gap-2.5 min-w-0 h-9 px-1">
  <span class="text-breeze-muted font-semibold text-[11px] uppercase tracking-wider shrink-0 flex items-center gap-1">
    <span>Status:</span>
  </span>
  <div class="flex items-center min-w-0 truncate">
    <%= render "searches/status_badge", search: search %>
  </div>
</div>

<div class="sm:col-span-9 w-full min-w-0">
  <div id="search_live_tracker" class="flex items-center gap-2.5 bg-black/40 border border-breeze-border/60 rounded-lg h-9 px-3 font-mono text-xs text-gray-300 shadow-inner w-full min-w-0">

    <span class="flex h-2 w-2 relative shrink-0">
      <% if search.status == 'processing' %>
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      <% else %>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-gray-500"></span>
      <% end %>
    </span>

    <span id="live_tracker_message" class="truncate flex-1 text-gray-300 text-[12px] font-sans">
      <% case search.status %>
      <% when "processing" %>
        <span class="text-emerald-400 font-semibold">Active Discovery:</span> Scanning targeted web sources in real-time...
      <% when "paused" %>
        <span class="text-amber-400 font-semibold">Campaign Paused:</span> Automated web scans are temporarily suspended.
      <% when "completed" %>
        <span class="text-blue-400 font-semibold">Scan Complete:</span> All active sources have been successfully processed.
      <% else %>
        <span class="text-gray-400 font-semibold">Ready:</span> Waiting to start active web discovery.
      <% end %>
    </span>
  </div>
</div>