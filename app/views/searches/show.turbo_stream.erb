<turbo-stream action="append" target="results_pool_list">
  <template>
    <% @results.each do |result| %>
      <%= render partial: "results/result_card", locals: { result: result }, formats: [:html] %>
    <% end %>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="results_count">
  <template>
    <span class="text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-full" id="results_count">
      Showing: <%= (@pagy.page - 1) * @pagy.limit + @results.count %> / <%= @pagy.count %>
    </span>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="results_pool_pagination">
  <template>
    <%= turbo_frame_tag "results_pool_pagination", data: { controller: "infinite-scroll" } do %>
      <% if @pagy.next %>
        <%= link_to "Load more updates...",
                    search_path(@search, status: params[:status], d: params[:d], page: @pagy.next, format: :turbo_stream),
                    data: { infinite_scroll_target: "link" },
                    class: "invisible block text-center py-2 w-full" %>
      <% end %>
    <% end %>
  </template>
</turbo-stream>