<div class="space-y-2">
  <label class="block text-xs font-semibold text-breeze-text">
    Google Search Query Dork Builder
  </label>

  <div data-controller="react-portal"
       data-react-portal-initial-value-value="<%= initial_value %>"
       data-react-portal-input-name-value="<%= input_name %>">

    <!-- Loading Skeleton during React Portal Hydration -->
    <div class="animate-pulse bg-breeze-bg/80 border border-breeze-border/80 rounded-xl p-4 space-y-4 h-[350px]">
      <div class="flex justify-between items-center border-b border-breeze-border/60 pb-2">
        <div class="h-4 bg-breeze-view rounded w-1/4"></div>
        <div class="h-6 bg-breeze-view rounded w-1/3"></div>
      </div>
      <div class="h-20 bg-breeze-view/60 rounded-lg"></div>
      <div class="h-12 bg-breeze-view/60 rounded-lg"></div>
      <div class="h-10 bg-breeze-view/40 rounded"></div>
    </div>

  </div>

  <% if @categories.present? %>
    <p class="text-[11px] text-breeze-muted/80 flex items-center gap-1 mt-1">
      <span>💡</span>
      <span>The crawler automatically appends targeted domains like <code class="bg-breeze-bg px-1 py-0.5 rounded text-breeze-accent font-mono text-[10px] border border-breeze-border/40">(site:domain.com)</code> based on your active selection.</span>
    </p>
  <% end %>
</div>