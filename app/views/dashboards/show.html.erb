<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Scraper Engine Dashboard</h1>
    <p class="text-sm text-gray-500 mt-1">Analytics for target domains, loads, and pipeline errors.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">🔥 Most Productive Domains</h2>
      <div class="space-y-4">
        <% if @target_efficiency.any? %>
          <% @target_efficiency.each do |domain, count| %>
            <% percentage = (count.to_f / @efficiency_max * 100).round %>
            <div>
              <div class="flex justify-between text-xs font-medium text-gray-700 mb-1">
                <span class="truncate max-w-[70%]"><%= domain %></span>
                <span class="font-bold text-gray-900"><%= count %> leads</span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
                <div class="bg-indigo-600 h-3 rounded-full" style="width: <%= percentage %>%"></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-400 text-sm text-center py-6">No data available</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between">
      <div>
        <h2 class="text-sm font-bold text-amber-500 uppercase tracking-wider mb-4">💀 Dead Weight Targets (Losers)</h2>
        <div class="space-y-3">
          <% if @loser_targets.any? %>
            <% @loser_targets.each do |target| %>
              <% results_count = Result.where("url LIKE ?", "%#{target.domain}%").count %>

              <div class="p-3 bg-amber-50/40 rounded-lg border border-amber-100 flex justify-between items-center">
                <div>
                  <div class="text-xs font-bold text-gray-800"><%= target.name %></div>
                  <div class="text-[10px] text-gray-400 font-mono"><%= target.domain %></div>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-semibold text-gray-700"><%= target.prompts_count %> requests</span>
                  <span class="block text-[10px] <%= results_count.zero? ? 'text-red-500 font-bold' : 'text-gray-400' %>">
                    <%= results_count %> leads found
                  </span>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-400 text-sm text-center py-6">No targets queried yet.</p>
          <% end %>
        </div>
      </div>
      <p class="text-[11px] text-amber-600 mt-4 border-t border-amber-100 pt-2">These sites take up a lot of prompt cycles but return almost zero results. Turn them off to save bandwidth.</p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">⏳ Engine Load (Prompts per Target)</h2>
      <div class="space-y-4">
        <% if @target_prompts.any? %>
          <% @target_prompts.each do |name, count| %>
            <% percentage = (count.to_f / @prompts_max * 100).round %>
            <div>
              <div class="flex justify-between text-xs font-medium text-gray-700 mb-1">
                <span class="truncate"><%= name %></span>
                <span class="font-bold"><%= count %> requests</span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
                <div class="bg-blue-600 h-3 rounded-full" style="width: <%= percentage %>%"></div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-400 text-sm text-center py-6">No data available</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between">
      <div>
        <h2 class="text-sm font-bold text-red-400 uppercase tracking-wider mb-4">⚠️ Top Pipeline Failures</h2>
        <div class="space-y-3">
          <% if @prompt_failures.any? %>
            <% @prompt_failures.each do |error, count| %>
              <div class="bg-red-50 p-3 rounded-lg border border-red-100 flex justify-between items-center">
                <span class="text-xs font-mono text-red-700 truncate max-w-[80%]" title="<%= error %>"><%= error %></span>
                <span class="bg-red-200 text-red-800 text-xs px-2 py-0.5 rounded-full font-bold"><%= count %></span>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-400 text-sm text-center py-8">No errors tracked. Pipeline is clean! 🚀</p>
          <% end %>
        </div>
      </div>
      <p class="text-[11px] text-gray-400 mt-4 border-t pt-2">If errors dominate, adjust delays or rotate Tor nodes.</p>
    </div>

  </div>
</div>
