<div class="max-w-4xl mx-auto px-3 sm:px-5 py-12 sm:py-16 space-y-8">
  <section class="text-center space-y-5">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-breeze-text">Brute Force Finder</h1>
      <p class="text-sm text-breeze-muted">Search the web across all configured search engines.</p>
    </div>

    <%= form_with url: quick_searches_path, method: :post, class: "flex flex-col sm:flex-row items-stretch gap-2 max-w-3xl mx-auto" do %>
      <%= text_field_tag :query, @query, required: true, maxlength: QuickSearch::Store::MAX_QUERY_LENGTH,
                         placeholder: "Search the web…", autocomplete: "off", autofocus: true,
                         class: "flex-1 min-w-0 min-h-12 rounded-xl border border-breeze-border bg-breeze-view px-4 py-3 text-base text-breeze-text placeholder:text-breeze-muted/60 shadow-sm focus:border-breeze-accent focus:outline-none focus:ring-2 focus:ring-breeze-accent/30" %>
      <%= submit_tag "Search", class: "min-h-12 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-7 py-3 text-sm font-bold text-white shadow-sm transition hover:from-blue-500 hover:to-indigo-500 cursor-pointer" %>
    <% end %>
  </section>

  <% if @quick_search %>
    <%= turbo_stream_from @quick_search_token, :results %>

    <section class="space-y-4">
      <div id="quick_search_status" class="rounded-xl border border-breeze-border bg-breeze-view px-4 py-3 shadow-sm" aria-live="polite">
        <%= render "quick_searches/status_content", quick_search: @quick_search, token: @quick_search_token %>
      </div>

      <div id="quick_search_results" class="space-y-4">
        <% @results.each do |result| %>
          <%= render "results/result_card", result: result, quick_search: true %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
