<% status = quick_search["status"].to_s %>
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
  <div class="flex items-center gap-3 min-w-0">
    <% if %w[queued processing verifying].include?(status) %>
      <span class="h-4 w-4 shrink-0 rounded-full border-2 border-breeze-accent/30 border-t-breeze-accent animate-spin" aria-hidden="true"></span>
    <% elsif status == "completed" %>
      <span class="text-emerald-400 text-base" aria-hidden="true">✓</span>
    <% else %>
      <span class="text-amber-400 text-base" aria-hidden="true">!</span>
    <% end %>

    <div class="min-w-0">
      <p class="text-sm font-medium text-breeze-text"><%= quick_search["message"] %></p>
    </div>
  </div>

  <% if status == "completed" && quick_search["results_count"].to_i.positive? %>
    <%= link_to "Save as campaign →", save_as_campaign_quick_search_path(token),
                class: "shrink-0 inline-flex items-center justify-center rounded-lg border border-breeze-accent/30 bg-breeze-accent/10 px-3 py-2 text-xs font-semibold text-breeze-accent transition hover:bg-breeze-accent/20" %>
  <% end %>
</div>
