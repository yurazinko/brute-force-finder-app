<div class="min-h-[80vh] flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-8">
  <div class="w-full max-w-md space-y-6 bg-breeze-view p-5 sm:p-8 rounded-xl border border-breeze-border shadow-sm">
    <header class="text-center">
      <h1 class="text-2xl font-bold text-breeze-text tracking-tight">Resend confirmation instructions</h1>
      <p class="mt-1 text-sm text-breeze-muted">Enter the email address you want to confirm.</p>
    </header>

    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-breeze-text mb-1.5" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          required: true,
                          placeholder: "name@company.com",
                          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
                          class: "w-full px-3.5 py-2.5 bg-breeze-bg border border-breeze-border rounded-lg text-breeze-text placeholder:text-breeze-muted/50 text-sm focus:outline-none focus:ring-2 focus:ring-breeze-accent focus:border-transparent transition" %>
      </div>

      <%= f.submit "Resend confirmation instructions",
                   class: "w-full py-2.5 px-4 bg-breeze-accent hover:opacity-90 text-white font-semibold text-sm rounded-lg shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-breeze-view focus:ring-breeze-accent" %>
    <% end %>

    <div class="pt-4 border-t border-breeze-border text-center text-sm text-breeze-muted space-y-1 [&_a]:text-breeze-accent [&_a]:hover:underline [&_a]:transition">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
