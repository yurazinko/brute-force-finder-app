<div class="min-h-[80vh] flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-6 bg-breeze-view p-5 sm:p-8 rounded-xl border border-breeze-border shadow-sm">

    <div class="text-center">
      <p class="mt-1 text-sm text-breeze-muted">
        Please enter your credentials to log in
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

      <div>
        <%= f.label :username, "Username", class: "block text-sm font-medium text-breeze-text mb-1.5" %>
        <%= f.text_field :username,
                          autofocus: true,
                          autocomplete: "username",
                          required: true,
                          placeholder: "e.g. alex_dev",
                          class: "w-full px-3.5 py-2.5 bg-breeze-bg border border-breeze-border rounded-lg text-breeze-text placeholder:text-breeze-muted/50 text-sm focus:outline-none focus:ring-2 focus:ring-breeze-accent focus:border-transparent transition" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-breeze-text mb-1.5" %>
        <%= f.password_field :password,
                             autocomplete: "current-password",
                             required: true,
                             placeholder: "••••••••",
                             class: "w-full px-3.5 py-2.5 bg-breeze-bg border border-breeze-border rounded-lg text-breeze-text placeholder:text-breeze-muted/50 text-sm focus:outline-none focus:ring-2 focus:ring-breeze-accent focus:border-transparent transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me,
                          class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent focus:ring-offset-breeze-view transition cursor-pointer" %>
          <%= f.label :remember_me, class: "ml-2 block text-sm text-breeze-text cursor-pointer select-none" %>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "Log in",
                     class: "w-full py-2.5 px-4 bg-breeze-accent hover:opacity-90 text-white font-medium text-sm rounded-lg shadow-sm transition duration-150 ease-in-out cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-breeze-view focus:ring-breeze-accent" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-breeze-border text-center text-sm text-breeze-muted [&_a]:text-breeze-accent [&_a]:hover:underline [&_a]:transition">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
