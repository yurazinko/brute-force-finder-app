<div class="p-6 space-y-5 animate-fade-in" id="modal_form_container">

  <!-- Success & Warning Notification -->
  <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 font-bold mt-0.5">
      ✓
    </div>
    <div class="space-y-1">
      <h4 class="text-xs font-bold text-emerald-400">Rule saved successfully!</h4>
      <p class="text-[11px] text-breeze-muted leading-relaxed">
        Please take a quick look at your rules below. <strong>Only web pages matching these patterns will be saved.</strong> Everything else on this website will be skipped, so make sure you haven't missed anything important!
      </p>
    </div>
  </div>

  <!-- All Configured Patterns for this Target -->
  <% target = target_pattern.target %>
  <% if target && target.target_patterns.any? %>
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold text-breeze-muted uppercase tracking-wider">All Active Rules for <%= target.domain %>:</span>
        <span class="text-[10px] text-breeze-muted font-mono"><%= target.target_patterns.size %> rule(s) total</span>
      </div>

      <div class="max-h-48 overflow-y-auto space-y-2 pr-1 [scrollbar-width:thin]">
        <% target.target_patterns.each do |pattern| %>
          <div class="p-3 bg-breeze-bg rounded-lg border border-breeze-border/60 flex items-center justify-between gap-3 text-xs font-mono">
            <div class="flex items-center gap-2 truncate">
              <span class="text-breeze-accent font-bold"><%= pattern.path_pattern %></span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded shrink-0 font-sans <%= pattern.is_active? ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-gray-500/10 text-gray-400' %>">
              <%= pattern.is_active? ? 'Active' : 'Disabled' %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Friendly Caution Box -->
  <div class="p-3.5 bg-amber-500/10 border border-amber-500/30 rounded-lg text-xs text-amber-300 flex items-start gap-2.5">
    <span class="text-base">⚠️</span>
    <div class="space-y-1">
      <span class="font-bold text-amber-200">Double-check before you finish:</span>
      <p class="text-[11px] text-amber-200/90 leading-relaxed">
        If a page URL doesn't match any of the rules listed above, our system will ignore it completely. If you spot a mistake or want to adjust something, just hit <strong>"Edit Again"</strong> right away!
      </p>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-breeze-border flex items-center justify-between sticky bottom-0 bg-breeze-view py-3">
    <%= link_to "Edit again", new_target_pattern_path(result_id: params[:result_id], redirect_to: params[:redirect_to]), data: { turbo_frame: "modal" }, class: "px-4 py-2 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition cursor-pointer underline" %>

    <%= link_to "Looks Good, Close Window", search_path(search), data: { turbo_frame: "_top" }, class: "py-2.5 px-6 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-md transition cursor-pointer" %>
  </div>

</div>