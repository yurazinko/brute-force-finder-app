<div class="p-6 space-y-5 animate-fade-in" id="modal_form_container">

  <!-- Success Banner Notification -->
  <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg flex items-center gap-3">
    <div class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 font-bold">
      ✓
    </div>
    <div>
      <h4 class="text-xs font-bold text-emerald-400">Pattern successfully saved!</h4>
      <p class="text-[11px] text-breeze-muted">The link pattern has been successfully linked to the target site. You can close this window or update the pattern if needed.</p>
    </div>
  </div>

  <!-- Saved Pattern Overview -->
  <div class="p-3.5 bg-breeze-bg rounded-lg border border-breeze-border/60 space-y-1">
    <span class="text-[11px] font-semibold text-breeze-muted uppercase tracking-wider">Configured Pattern:</span>
    <div class="text-xs font-mono font-bold text-breeze-accent bg-breeze-accent/10 px-3 py-2 rounded border border-breeze-accent/20 break-all">
      <%= target_pattern.path_pattern %>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-breeze-border flex items-center justify-between sticky bottom-0 bg-breeze-view py-3">
    <%= link_to "Edit Again", new_target_pattern_path(result_id: params[:result_id]), data: { turbo_frame: "modal" }, class: "px-4 py-2 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition cursor-pointer underline" %>

    <%= link_to "Close Window", search_path(search), data: { turbo_frame: "_top" }, class: "py-2 px-6 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-lg shadow-sm transition cursor-pointer" %>
  </div>

</div>