<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-fade-in"
       data-controller="modal"
       data-action="click->modal#closeBackground keyup@window->modal#closeWithEsc">

    <div class="bg-breeze-view border border-breeze-border rounded-xl shadow-2xl w-full max-w-7xl flex flex-col max-h-[90vh] overflow-y-auto">

      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-breeze-border flex items-center justify-between bg-breeze-bg/50 sticky top-0 z-30">
        <h3 class="text-sm font-bold text-breeze-text flex items-center gap-2">
          <span>✨</span>
          <span>Configure Link Pattern</span>
        </h3>
        <%= link_to "✕", search_path(@search), data: { turbo_frame: "_top" }, class: "text-breeze-muted hover:text-breeze-text transition text-xs font-bold px-2 py-1 rounded-md bg-breeze-bg border border-breeze-border/60" %>
      </div>

      <!-- Modal Body (без дублюючих turbo_frame атрибутів на формі) -->
      <%= form_with model: @target_pattern, url: target_patterns_path, method: :post, class: "p-6 space-y-5" do |f| %>
        <%= hidden_field_tag :result_id, @result.id %>

        <%
           uri_obj = URI.parse(@result.url) rescue nil
           extracted_domain = uri_obj&.host&.sub(Utils::UrlNormalizer::WWW_PREFIX, "")
        %>
        <% if @matched_target %>
          <%= f.hidden_field :target_id, value: @matched_target.id %>
        <% end %>

        <!-- Target Info / Category Selection -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 bg-breeze-bg rounded-lg border border-breeze-border/60">
          <div class="flex items-center gap-2 truncate">
            <span class="text-xs font-semibold text-breeze-muted shrink-0">Target Site:</span>
            <span class="text-xs font-mono font-bold text-breeze-accent bg-breeze-accent/10 px-2.5 py-1 rounded border border-breeze-accent/20 truncate" title="<%= @matched_target&.domain || extracted_domain %>">
              <%= @matched_target&.domain || extracted_domain %>
            </span>
          </div>

          <% if @matched_target %>
            <div class="flex items-center gap-1.5 text-[11px] text-breeze-muted shrink-0">
              <span>🔗 Link to existing target</span>
            </div>
          <% else %>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[11px] text-breeze-muted">Category:</span>
              <% if current_user.categories.any? %>
                <div class="flex items-center gap-2">
                  <%= select_tag "target_pattern[category_id]",
                      options_from_collection_for_select(current_user.categories.order(:name), :id, :name),
                      prompt: "Select category...",
                      class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 focus:border-breeze-accent focus:ring-1 focus:ring-breeze-accent outline-none transition cursor-pointer" %>

                  <span class="text-[11px] text-breeze-muted">or</span>
                  <%= text_field_tag "target_pattern[category_name]", nil,
                      placeholder: "New category name...",
                      class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 focus:border-breeze-accent outline-none w-36" %>
                </div>
              <% else %>
                <%= text_field_tag "target_pattern[category_name]", nil,
                    placeholder: "Enter category name...",
                    class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 focus:border-breeze-accent outline-none w-44" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Full URL Preview -->
        <div>
          <label class="block text-xs font-semibold text-breeze-muted mb-1">Full URL Sample:</label>
          <div class="p-2.5 bg-breeze-bg rounded-lg border border-breeze-border text-xs font-mono text-gray-400 break-all select-all">
            <%= @result.url %>
          </div>
        </div>

        <!-- Interactive Path Segment Builder -->
        <div class="space-y-2" data-controller="path-builder">
          <label class="block text-xs font-semibold text-breeze-text">Path Segments (Interactive Builder):</label>
          <p class="text-[11px] text-breeze-muted">
            Click on any segment to keep it exact, turn it into <code class="text-breeze-accent bg-breeze-bg px-1 py-0.5 rounded border border-breeze-border">{anything}</code>, or cut off the URL path from that point.
          </p>

          <div class="flex flex-wrap items-center gap-1.5 p-3.5 bg-breeze-bg rounded-lg border border-breeze-border font-mono text-xs">
            <span class="text-breeze-muted shrink-0">/</span>
            <% @path_segments.each_with_index do |segment, index| %>
              <% next if segment.blank? %>
              <div class="relative inline-block segment-container min-w-[90px] max-w-[200px]" data-controller="dropdown">
                <button type="button"
                        data-action="click->dropdown#toggle click@window->dropdown#hide"
                        class="w-full px-2.5 py-1.5 rounded bg-breeze-view hover:bg-breeze-border/40 text-breeze-text border border-breeze-border transition flex items-center justify-between gap-2 shadow-2xs font-semibold truncate"
                        data-path-builder-target="segment"
                        data-mode="exact"
                        data-original-value="<%= segment %>"
                        title="<%= segment %>">
                  <span data-path-builder-target="label" class="truncate"><%= segment %></span>
                  <span class="text-[10px] text-breeze-muted shrink-0">▼</span>
                </button>

                <div data-dropdown-target="menu" class="hidden absolute left-0 top-full mt-1 z-50 w-full min-w-[150px] bg-breeze-view border border-breeze-border rounded-lg shadow-2xl py-1 text-[11px] font-sans">
                  <button type="button"
                          data-action="click->path-builder#setExact"
                          class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-text transition font-semibold truncate">
                    🔒 Keep exact
                  </button>
                  <button type="button"
                          data-action="click->path-builder#setAnything"
                          class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-accent transition truncate">
                    ✨ Skip ({anything})
                  </button>
                  <button type="button"
                          data-action="click->path-builder#removeSegment"
                          class="w-full text-left px-3 py-2 hover:bg-red-500/20 text-red-400 transition truncate border-t border-breeze-border/40">
                    🗑️ Remove (cut here)
                  </button>
                </div>
              </div>
              <span class="text-breeze-muted shrink-0 separator-slash">/</span>
            <% end %>
          </div>

          <%= f.hidden_field :path_pattern, data: { path_builder_target: "input" }, value: @default_path %>
        </div>

        <!-- Hint -->
        <div class="p-3 bg-breeze-bg/50 rounded-lg border border-breeze-border/50 text-[11px] text-breeze-muted flex items-center gap-2">
          <span>💡</span>
          <span>Parameters after <code class="text-breeze-text">?</code> are handled automatically if <strong class="text-breeze-text">Keep URL Parameters</strong> is enabled.</span>
        </div>

        <!-- Footer Actions -->
        <div class="pt-4 border-t border-breeze-border flex items-center justify-end gap-3 sticky bottom-0 bg-breeze-view py-3">
          <%= link_to "Cancel", search_path(@search), data: { turbo_frame: "_top" }, class: "px-4 py-2 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition cursor-pointer" %>
          <%= f.submit "Save Pattern", class: "py-2 px-5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-sm transition cursor-pointer border border-blue-400/20" %>
        </div>

      <% end %>
    </div>
  </div>
<% end %>