<%
   uri_obj = URI.parse(result&.url || (matched_target&.domain ? "https://#{matched_target.domain}" : "")) rescue nil
   extracted_domain = uri_obj&.host&.sub(Utils::UrlNormalizer::WWW_PREFIX, "")
   target_domain = matched_target&.domain || extracted_domain
%>

<% if matched_target && matched_target.persisted? %>
  <div class="bg-breeze-view p-4 shadow-sm border border-breeze-border rounded-xl space-y-4 mb-6">
    <div class="flex items-center justify-between border-b border-breeze-border/60 pb-3">
      <div>
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>🛤️</span>
          <span>Configured URL Path Patterns</span>
        </h2>
        <p class="text-[11px] text-breeze-muted mt-0.5">If no patterns are added, all paths under <strong><%= target_domain %></strong> are accepted.</p>
      </div>
      <span class="bg-breeze-accent/10 text-breeze-accent border border-breeze-accent/20 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full">
        <%= matched_target.target_patterns.size %>
      </span>
    </div>

    <!-- Список існуючих паттернів -->
    <div class="space-y-2">
      <% if matched_target.target_patterns.any? %>
        <% matched_target.target_patterns.each do |pattern| %>
          <div class="flex items-center justify-between bg-breeze-bg p-3 rounded-lg border border-breeze-border/60 font-mono text-xs">
            <div class="flex items-center gap-2 truncate">
              <span class="text-breeze-accent font-bold"><%= pattern.path_pattern %></span>
              <span class="text-[10px] px-2 py-0.5 rounded <%= pattern.is_active? ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-gray-500/10 text-gray-400' %>">
                <%= pattern.is_active? ? 'Active' : 'Disabled' %>
              </span>
            </div>

            <div class="flex items-center gap-2 font-sans">
              <!-- Toggle status button -->
              <%= button_to (pattern.is_active? ? 'Disable' : 'Enable'),
                            target_pattern_path(pattern, target_pattern: { is_active: !pattern.is_active? }, result_id: result&.id, redirect_to: redirect_path),
                            method: :patch,
                            form: { data: { turbo_frame: result&.id.present? ? "modal" : "_top" } },
                            class: "text-[11px] px-2 py-1 bg-breeze-view hover:bg-breeze-border/40 text-breeze-muted hover:text-breeze-text border border-breeze-border rounded transition cursor-pointer" %>

              <!-- Delete pattern -->
              <%= button_to "Delete",
                            target_pattern_path(pattern, result_id: result&.id, redirect_to: redirect_path),
                            method: :delete,
                            form: { data: { turbo_frame: result&.id.present? ? "modal" : "_top", turbo_confirm: "Are you sure you want to delete this pattern?" } },
                            class: "text-[11px] px-2 py-1 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 rounded transition cursor-pointer" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4 bg-breeze-bg/40 rounded-lg border border-dashed border-breeze-border/60 text-xs text-breeze-muted italic">
          No custom path patterns configured yet.
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Головна форма створення нового патерну -->
<%= form_with model: target_pattern, url: target_patterns_path, method: :post, class: "space-y-5", data: { controller: "path-builder", action: "submit->path-builder#validate" } do |f| %>
  <%= hidden_field_tag :result_id, result&.id if result %>
  <%= hidden_field_tag :redirect_to, redirect_path if redirect_path %>

  <% if matched_target %>
    <%= f.hidden_field :target_id, value: matched_target.id %>
  <% end %>

  <!-- Error Banner -->
  <div data-path-builder-target="error" class="hidden p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-xs text-red-400 font-semibold flex items-center gap-2">
    <span>⚠️</span>
    <span>Category can't be blank</span>
  </div>

  <!-- Target & Category Selection -->
  <% if params["controller"] == "target_patterns" %>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 bg-breeze-bg rounded-lg border border-breeze-border/60">
    <div class="flex items-center gap-2 truncate">
      <span class="text-xs font-semibold text-breeze-muted shrink-0">Target Site:</span>
      <span class="text-xs font-mono font-bold text-breeze-accent bg-breeze-accent/10 px-2.5 py-1 rounded border border-breeze-accent/20 truncate" title="<%= target_domain %>">
        <%= target_domain %>
      </span>
    </div>

      <% if matched_target %>
        <div class="flex items-center gap-1.5 text-[11px] text-emerald-400 shrink-0 font-medium">
          <span>🔗 Linking to existing target</span>
        </div>
      <% else %>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] text-breeze-muted">Category:</span>
          <% if current_user.categories.any? %>
            <%= select_tag "target_pattern[category_id]",
                options_from_collection_for_select(current_user.categories.order(:name), :id, :name),
                prompt: "Select category...",
                data: { path_builder_target: "categorySelect" },
                class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 focus:border-breeze-accent outline-none cursor-pointer" %>
            <span class="text-[11px] text-breeze-muted">or</span>
            <%= text_field_tag "target_pattern[category_name]", nil,
                placeholder: "New category name...",
                data: { path_builder_target: "categoryInput" },
                class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 outline-none w-36" %>
          <% else %>
            <%= text_field_tag "target_pattern[category_name]", nil,
                placeholder: "Enter category name...",
                data: { path_builder_target: "categoryInput" },
                class: "text-xs font-sans bg-breeze-view text-breeze-text rounded-md border border-breeze-border px-2.5 py-1.5 outline-none w-44" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- URL Preview -->
  <% if result %>
    <div>
      <label class="block text-xs font-semibold text-breeze-muted mb-1">Full URL Sample:</label>
      <div class="p-2.5 bg-breeze-bg rounded-lg border border-breeze-border text-xs font-mono text-gray-400 break-all select-all">
        <%= result.url %>
      </div>
    </div>
  <% end %>

<!-- Interactive Path Segment Builder -->
  <div class="space-y-2">
    <label class="block text-xs font-semibold text-breeze-text">Add New Path Pattern:</label>
    <p class="text-[11px] text-breeze-muted">
      Click segments to configure matching rules, type custom text, or paste a full URL to auto-fill.
    </p>

    <!-- HTML Template -->
    <template data-path-builder-target="template">
      <span class="text-breeze-muted shrink-0 segment-slash">/</span>
      <div class="relative inline-block segment-container min-w-[90px] max-w-[200px]" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle click@window->dropdown#hide"
                class="w-full px-2.5 py-1.5 rounded bg-breeze-view hover:bg-breeze-border/40 text-breeze-text border border-breeze-border transition flex items-center justify-between gap-2 shadow-2xs font-semibold truncate"
                data-path-builder-target="segment"
                data-mode="exact"
                data-original-value="new"
                title="new">
          <span data-path-builder-target="label" class="truncate">new</span>
          <span class="text-[10px] text-breeze-muted shrink-0">▼</span>
        </button>

        <div data-dropdown-target="menu" class="hidden absolute left-0 top-full mt-1 z-50 w-full min-w-[240px] bg-breeze-view border border-breeze-border rounded-lg shadow-2xl py-1 text-[11px] font-sans">
          <div class="p-2 border-b border-breeze-border/40 bg-breeze-bg/40 space-y-1" data-action="click->path-builder#stopPropagation">
            <input type="text"
                   placeholder="Type value or paste URL..."
                   data-action="keydown.enter->path-builder#applyCustomInput click->path-builder#stopPropagation"
                   class="w-full text-[11px] font-sans px-2 py-1 bg-breeze-view text-breeze-text rounded border border-breeze-border outline-none focus:border-breeze-accent">
            <div class="text-[9px] text-breeze-muted">Press Enter or paste full URL</div>
          </div>
          <button type="button" data-action="click->path-builder#setExact" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-text font-semibold truncate">
            🔒 Exact match
          </button>
          <button type="button" data-action="click->path-builder#setWildcardFolder" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-accent truncate">
            📁 Any subfolders
          </button>
          <button type="button" data-action="click->path-builder#setWildcardSuffix" data-path-builder-target="suffixWildcardButton" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-accent truncate">
            🔤 Starts with this text
          </button>
          <button type="button" data-action="click->path-builder#removeSegment" class="w-full text-left px-3 py-2 hover:bg-red-500/20 text-red-400 truncate border-t border-breeze-border/40">
            🗑️ Cut path from here
          </button>
        </div>
      </div>
    </template>

    <% segments_list = path_segments.presence || [""] %>
    <div class="flex flex-wrap items-center gap-1.5 p-3.5 bg-breeze-bg rounded-lg border border-breeze-border font-mono text-xs" data-path-builder-target="segmentsContainer">
      <% segments_list.each_with_index do |segment, _index| %>
        <span class="text-breeze-muted shrink-0 segment-slash">/</span>
        <div class="relative inline-block segment-container min-w-[90px] max-w-[200px]" data-controller="dropdown">
          <button type="button"
                  data-action="click->dropdown#toggle click@window->dropdown#hide"
                  class="w-full px-2.5 py-1.5 rounded bg-breeze-view hover:bg-breeze-border/40 text-breeze-text border border-breeze-border transition flex items-center justify-between gap-2 shadow-2xs font-semibold truncate"
                  data-path-builder-target="segment"
                  data-mode="exact"
                  data-original-value="<%= segment %>"
                  title="<%= segment %>">
            <span data-path-builder-target="label" class="truncate"><%= segment.presence || "segment" %></span>
            <span class="text-[10px] text-breeze-muted shrink-0">▼</span>
          </button>

          <div data-dropdown-target="menu" class="hidden absolute left-0 top-full mt-1 z-50 w-full min-w-[240px] bg-breeze-view border border-breeze-border rounded-lg shadow-2xl py-1 text-[11px] font-sans">
            <div class="p-2 border-b border-breeze-border/40 bg-breeze-bg/40 space-y-1" data-action="click->path-builder#stopPropagation">
              <input type="text"
                     placeholder="Type value or paste URL..."
                     data-action="keydown.enter->path-builder#applyCustomInput click->path-builder#stopPropagation"
                     class="w-full text-[11px] font-sans px-2 py-1 bg-breeze-view text-breeze-text rounded border border-breeze-border outline-none focus:border-breeze-accent">
              <div class="text-[9px] text-breeze-muted">Press Enter or paste full URL</div>
            </div>
            <button type="button" data-action="click->path-builder#setExact" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-text font-semibold truncate">
              🔒 Exact match
            </button>
            <button type="button" data-action="click->path-builder#setWildcardFolder" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-accent truncate">
              ✨ Any value
            </button>
            <button type="button" data-action="click->path-builder#setWildcardSuffix" data-path-builder-target="suffixWildcardButton" class="w-full text-left px-3 py-2 hover:bg-breeze-accent/20 text-breeze-accent truncate">
              🔤 Starts with this text
            </button>
            <button type="button" data-action="click->path-builder#removeSegment" class="w-full text-left px-3 py-2 hover:bg-red-500/20 text-red-400 truncate border-t border-breeze-border/40">
              🛑 Cut path from here
            </button>
          </div>
        </div>
      <% end %>

      <button type="button"
              data-action="click->path-builder#addSegment"
              class="shrink-0 w-8 h-8 rounded-lg bg-breeze-view hover:bg-breeze-accent/20 text-breeze-accent border border-breeze-border flex items-center justify-center font-bold text-sm shadow-2xs transition cursor-pointer ml-1"
              title="Add path segment">
        +
      </button>
    </div>

    <!-- Human Interpretation Banner -->
    <div class="p-3 bg-blue-500/10 border border-blue-500/30 rounded-lg text-xs text-blue-300 flex items-start gap-2 mt-2">
      <span>💡</span>
      <div>
        <span class="font-bold">Human Interpretation:</span>
        <p data-path-builder-target="interpretation" class="font-mono text-[11px] mt-0.5 text-blue-200">Will match URLs matching this pattern.</p>
      </div>
    </div>

    <%= f.hidden_field :path_pattern, data: { path_builder_target: "input" }, value: default_path %>
  </div>


  <!-- Allow Query Strings -->
  <% if params["controller"] == "target_patterns" %>
    <div class="p-3 bg-breeze-bg/50 rounded-lg border border-breeze-border/50 text-[11px] text-breeze-muted flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <%= check_box_tag "target_pattern[allow_query_strings]", "1", matched_target&.allow_query_strings, id: "allow_query_strings_checkbox", class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent cursor-pointer" %>
        <label for="allow_query_strings_checkbox" class="text-xs font-semibold text-breeze-text cursor-pointer select-none">Keep URL Parameters</label>
      </div>
      <p class="text-[10px] text-breeze-muted pl-6">
        Prevents the system from stripping tracking or pagination parameters for this site.
      </p>
    </div>
  <% end %>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-breeze-border flex items-center justify-end gap-3 sticky bottom-0 bg-breeze-view py-3">
    <%= link_to "Cancel", redirect_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition cursor-pointer" %>
    <%= f.submit "Save Pattern", class: "py-2 px-5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-sm transition cursor-pointer" %>
  </div>

<% end %>