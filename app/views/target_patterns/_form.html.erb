<%
   uri_obj = URI.parse(result&.url || (matched_target&.domain ? "https://#{matched_target.domain}" : "")) rescue nil
   extracted_domain = uri_obj&.host&.sub(Utils::UrlNormalizer::WWW_PREFIX, "")
   target_domain = matched_target&.domain || extracted_domain

   patterns_data = matched_target&.persisted? ? matched_target.target_patterns.map { |p| { id: p.id, path_pattern: p.path_pattern, is_active: p.is_active? } } : []
   categories_data = current_user.categories.order(:name).map { |c| { id: c.id, name: c.name } }
%>

<div data-controller="path-builder"
     data-path-builder-target-domain-value="<%= target_domain %>"
     data-path-builder-initial-patterns-value="<%= patterns_data.to_json %>"
     data-path-builder-categories-value="<%= categories_data.to_json %>"
     data-path-builder-result-url-value="<%= result&.url %>"
     data-path-builder-matched-target-id-value="<%= matched_target&.id %>"
     data-path-builder-authenticity-token-value="<%= form_authenticity_token %>"
     data-path-builder-create-endpoint-value="<%= target_patterns_path %>"
     data-path-builder-redirect-path-value="<%= redirect_path %>">
</div>