<div class="max-w-md mx-auto px-4 py-12">
  <div class="mb-6">
    <%= link_to '← Cancel', categories_path, class: "text-sm text-breeze-muted hover:text-breeze-text" %>
    <h1 class="text-3xl font-bold text-breeze-text mt-2">Edit Category</h1>
  </div>

  <%= form_with(model: @category, local: true, class: "space-y-6 bg-breeze-view p-6 shadow-sm border border-breeze-border rounded-xl") do |f| %>
    <% if @category.errors.any? %>
      <div class="bg-red-50 p-4 rounded-lg text-red-700 text-sm">
        <h2 class="font-bold mb-1">Errors:</h2>
        <ul class="list-disc pl-5">
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Category Name", class: "block text-sm font-medium text-breeze-text mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-md border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent text-sm" %>
    </div>

    <div class="flex justify-end space-x-3 pt-2">
      <%= link_to 'Back', categories_path, class: "py-2 px-4 border border-breeze-border rounded-md text-sm font-medium text-breeze-text hover:bg-breeze-bg" %>
      <%= f.submit "Update Category", class: "py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 cursor-pointer" %>
    </div>
  <% end %>
</div>