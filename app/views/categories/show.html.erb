<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to '⬅️ Back to Categories', categories_path, class: "text-sm text-breeze-muted hover:text-breeze-text" %>
    <h1 class="text-3xl font-bold text-breeze-text mt-2">Manage Category: <%= @category.name %></h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-1 bg-breeze-view p-6 shadow rounded-xl h-fit">
      <h2 class="text-sm font-semibold text-breeze-muted uppercase tracking-wider mb-4">Add New Target Site</h2>
      <%= form_with(model: Target.new, class: "space-y-4") do |f| %>
        <%= f.hidden_field :category_id, value: @category.id %>

        <div>
          <%= f.label :name, "Site Name", class: "block text-xs font-medium text-breeze-text mb-1" %>
          <%= f.text_field :name, placeholder: "e.g., Workable", class: "w-full text-sm rounded-md border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent" %>
        </div>

        <div>
          <%= f.label :domain, "Domain", class: "block text-xs font-medium text-breeze-text mb-1" %>
          <%= f.text_field :domain, placeholder: "e.g., workable.com", class: "w-full text-sm font-mono rounded-md border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :allow_query_strings, "Keep URL Query Parameters", class: "block text-xs font-medium text-breeze-text mb-1" %>
          <%= f.check_box :allow_query_strings, class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
        </div>
        <%= f.submit "Add Site", class: "w-full py-2 px-4 bg-gray-900 hover:bg-gray-800 text-white font-medium text-sm rounded-md shadow cursor-pointer transition" %>
      <% end %>
    </div>

    <div class="md:col-span-2 bg-breeze-view p-6 shadow rounded-xl">
      <h2 class="text-sm font-semibold text-breeze-muted uppercase tracking-wider mb-4">Linked Target Sites (<%= @category.targets.count %>)</h2>

      <div class="divide-y divide-gray-100" id="targets_list">
        <% if @category.targets.any? %>
          <%= render partial: "targets/target_row", collection: @category.targets.order(:name), as: :target %>
        <% else %>
          <p class="text-breeze-muted text-sm py-4 text-center">No target sites added to this category yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>