<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-6">

  <!-- Header Section -->
  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <%= link_to categories_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition shrink-0 bg-breeze-bg/50 px-2.5 py-1 rounded-md border border-breeze-border/60 mb-2" do %>
        <span>⬅️</span>
        <span>Back to Categories</span>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-bold text-breeze-text flex items-center gap-2">
        <span>⚙️</span>
        <span>Manage Category: <span class="text-breeze-accent"><%= @category.name %></span></span>
      </h1>
      <p class="text-xs sm:text-sm text-breeze-muted mt-1">
        Configure targets and crawling domains assigned to this provider category.
      </p>
    </div>
  </div>

  <!-- Layout Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Add New Target Form Panel -->
    <div class="md:col-span-1 bg-breeze-view p-5 sm:p-6 shadow-xs border border-breeze-border/80 rounded-xl h-fit space-y-4">
      <div class="border-b border-breeze-border/60 pb-3">
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>➕</span>
          <span>Add New Target Site</span>
        </h2>
      </div>

      <%= form_with(model: Target.new, class: "space-y-4") do |f| %>
        <%= f.hidden_field :category_id, value: @category.id %>

        <div>
          <%= f.label :name, "Site Name", class: "block text-xs font-semibold text-breeze-text mb-1" %>
          <%= f.text_field :name, placeholder: "e.g., Workable", class: "w-full text-xs sm:text-sm bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border p-2.5 focus:border-breeze-accent focus:ring-1 focus:ring-breeze-accent outline-none placeholder:text-breeze-muted/50 transition-all" %>
        </div>

        <div>
          <%= f.label :domain, "Domain", class: "block text-xs font-semibold text-breeze-text mb-1" %>
          <%= f.text_field :domain, placeholder: "e.g., workable.com", class: "w-full text-xs sm:text-sm font-mono bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border p-2.5 focus:border-breeze-accent focus:ring-1 focus:ring-breeze-accent outline-none placeholder:text-breeze-muted/50 transition-all" %>
        </div>

        <div class="p-3 bg-breeze-bg/50 rounded-lg border border-breeze-border/50 flex items-center gap-3">
          <%= f.check_box :allow_query_strings, class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
          <div>
            <%= f.label :allow_query_strings, "Keep URL Parameters", class: "block text-xs font-semibold text-breeze-text cursor-pointer" %>
            <p class="text-[10px] text-breeze-muted">Preserve GET parameters during link extraction</p>
          </div>
        </div>

        <%= f.submit "Add Site", class: "w-full py-2.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-sm transition-all cursor-pointer border border-blue-400/20" %>
      <% end %>
    </div>

    <!-- Target Sites List Panel -->
    <div class="md:col-span-2 bg-breeze-view p-5 sm:p-6 shadow-xs border border-breeze-border/80 rounded-xl space-y-4">
      <div class="border-b border-breeze-border/60 pb-3 flex items-center justify-between">
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>🎯</span>
          <span>Linked Target Sites</span>
        </h2>
        <span class="bg-breeze-accent/10 text-breeze-accent border border-breeze-accent/20 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full">
          <%= @category.targets.size %>
        </span>
      </div>

      <div class="divide-y divide-breeze-border/60" id="targets_list">
        <% if @category.targets.any? %>
          <%= render partial: "targets/target_row", collection: @category.targets, as: :target %>
        <% else %>
          <div class="text-center py-8 bg-breeze-bg/30 rounded-lg border border-dashed border-breeze-border/60">
            <p class="text-breeze-muted text-xs italic">No target sites added to this category yet.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>