<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4 sm:space-y-6">

  <!-- Header Section -->
  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <%= link_to categories_path, class: "inline-flex items-center gap-1.5 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition shrink-0 bg-breeze-bg/50 px-2.5 py-1 rounded-md border border-breeze-border/60" do %>
        <span>⬅️</span>
        <span>Back to Categories</span>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-bold text-breeze-text mt-2 flex items-center gap-2">
        <span>⚙️</span>
        <span>Manage Category: <span class="text-breeze-accent"><%= @category.name %></span></span>
      </h1>
      <p class="text-xs text-breeze-muted mt-1 font-sans">
        Configure targets and crawling domains assigned to this provider category.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs font-mono font-bold px-3 py-1 rounded-full border bg-breeze-accent/10 text-breeze-accent border-breeze-accent/20">
        <%= @category.targets.size %> Targets Assigned
      </span>
    </div>
  </div>

  <!-- Flash Messages Feedback -->
  <% if flash[:notice].present? %>
    <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-xs font-bold text-emerald-400 flex items-center gap-2">
      <span>✓</span>
      <span><%= flash[:notice] %></span>
    </div>
  <% elsif flash[:alert].present? %>
    <div class="p-4 bg-red-500/10 border border-red-500/30 rounded-lg text-xs font-bold text-red-400 flex items-center gap-2">
      <span>⚠️</span>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <!-- Main Grid Layout (Matching Search & Target Edit Architecture) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">

    <!-- Left Column: Add New Target Form Panel (1 col - compact) -->
    <div class="lg:col-span-1 bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl space-y-4 h-fit">
      <div class="border-b border-breeze-border/60 pb-3">
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>➕</span>
          <span>Add New Target Site</span>
        </h2>
        <p class="text-[11px] text-breeze-muted mt-0.5">Register a new domain source.</p>
      </div>

      <%= form_with(model: Target.new, class: "space-y-4") do |f| %>
        <%= f.hidden_field :category_id, value: @category.id %>

        <div>
          <%= f.label :name, "Site Name", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name, placeholder: "e.g., Workable",
                             class: "w-full text-sm bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2.5 outline-none transition" %>
        </div>

        <div>
          <%= f.label :domain, "Domain", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :domain, placeholder: "e.g., workable.com",
                             class: "w-full text-sm font-mono bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2.5 outline-none transition" %>
        </div>

        <div class="p-3.5 bg-breeze-bg rounded-lg border border-breeze-border/60 space-y-2">
          <div class="flex items-center gap-3">
            <%= f.check_box :allow_query_strings, class: "h-4 w-4 rounded border-breeze-border bg-breeze-view text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
            <%= f.label :allow_query_strings, "Keep URL Parameters", class: "text-xs font-semibold text-breeze-text cursor-pointer select-none" %>
          </div>
          <p class="text-[10px] text-breeze-muted pl-7 leading-relaxed">
            Preserve GET parameters during link extraction for tracking-heavy sites.
          </p>
        </div>

        <% if current_user.searches.any? %>
          <div class="space-y-2 pt-2 border-t border-breeze-border/60">
            <label class="block text-xs font-semibold text-breeze-muted uppercase tracking-wider">Attach to Active Searches:</label>
            <div class="max-h-60 overflow-y-auto space-y-1.5 pr-1 [scrollbar-width:thin]">
              <% current_user.searches.order(title: :asc).each do |search| %>
                <label class="flex items-center gap-2.5 text-xs text-breeze-text cursor-pointer bg-breeze-bg/50 hover:bg-breeze-bg p-2 rounded-md border border-breeze-border/40 transition">
                  <%= check_box_tag "target[search_ids][]", search.id, false, class: "h-3.5 w-3.5 rounded border-breeze-border bg-breeze-view text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
                  <span class="truncate"><%= search.title %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= f.submit "Add Site", class: "w-full py-2.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-md transition cursor-pointer text-center border border-blue-400/20" %>
      <% end %>
    </div>

    <!-- Right Column: Target Sites List Panel (2 cols - wide) -->
    <div class="lg:col-span-2 bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl space-y-4">
      <div class="border-b border-breeze-border/60 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
            <span>🎯</span>
            <span>Linked Target Sites</span>
          </h2>
          <p class="text-[11px] text-breeze-muted mt-0.5">Active web extraction endpoints for this category.</p>
        </div>
        <span class="bg-breeze-accent/10 text-breeze-accent border border-breeze-accent/20 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full">
          <%= @category.targets.size %>
        </span>
      </div>

      <div class="divide-y divide-breeze-border/60" id="targets_list">
        <% if @category.targets.any? %>
          <%= render partial: "targets/target_row", collection: @category.targets, as: :target %>
        <% else %>
          <div class="text-center py-8 bg-breeze-bg/40 rounded-lg border border-dashed border-breeze-border/60">
            <p class="text-breeze-muted text-xs italic">No target sites added to this category yet.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>