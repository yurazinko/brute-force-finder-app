<div class="max-w-md mx-auto px-4 py-12">

  <div class="mb-6">
    <%= link_to '← Back to Categories', categories_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
    <h1 class="text-3xl font-bold text-gray-900 mt-2">New Target Category</h1>
    <p class="text-sm text-gray-500 mt-1">Create a group to organize your scraping targets (e.g., "ATS Platforms", "Local Boards").</p>
  </div>

  <%= form_with(model: @category, local: true, class: "space-y-6 bg-white p-6 shadow-sm border border-gray-200 rounded-xl") do |f| %>

    <% if @category.errors.any? %>
      <div class="bg-red-50 border border-red-200 p-4 rounded-lg text-red-700 text-sm">
        <h2 class="font-bold mb-1"><%= pluralize(@category.errors.count, "error") %> prohibited this category from being saved:</h2>
        <ul class="list-disc pl-5 text-red-600">
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Category Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :name, placeholder: "e.g., Greenhouse & Lever Sites", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5" %>
    </div>

    <div class="flex justify-end space-x-3 pt-2 border-t border-gray-100">
      <%= link_to 'Cancel', categories_path, class: "py-2.5 px-4 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition cursor-pointer" %>
      <%= f.submit "Save Category", class: "py-2.5 px-5 bg-gradient-to-r from-gray-900 to-gray-800 hover:from-gray-800 hover:to-gray-700 text-white font-semibold rounded-lg shadow-sm hover:shadow transition text-sm cursor-pointer" %>
    </div>

  <% end %>
</div>