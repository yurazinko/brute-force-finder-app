<div class="max-w-7xl mx-auto px-4 py-8">

  <div class="flex justify-between items-center mb-8">
    <div>
      <%= link_to '← Back to Campaigns', searches_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
      <h1 class="text-3xl font-bold text-gray-900 mt-2">Target Categories</h1>
      <p class="text-sm text-gray-500 mt-1">Manage your scraping sources, platforms, and search engines.</p>
    </div>
    <%= link_to 'Create New Category', new_category_path, class: "bg-gray-900 hover:bg-gray-800 text-white font-medium py-2.5 px-4 rounded-lg shadow transition text-sm cursor-pointer" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @categories.any? %>
      <% @categories.each do |category| %>
        <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 flex flex-col justify-between hover:shadow-md transition">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h2 class="text-xl font-bold text-gray-900"><%= category.name %></h2>
              <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2.5 py-1 rounded-md">
                <%= category.targets.count %> sites
              </span>
            </div>

            <div class="mt-4 space-y-1">
              <% if category.targets.any? %>
                <% category.targets.order(:name).limit(5).each do |target| %>
                  <div class="flex items-center justify-between text-xs font-mono py-1 border-b border-gray-50 last:border-none">
                    <span class="<%= target.is_active? ? 'text-gray-700' : 'text-gray-400 line-through' %>">
                      <%= target.name %>
                    </span>
                    <span class="text-gray-400 text-[10px]"><%= target.domain %></span>
                  </div>
                <% end %>
                <% if category.targets.count > 5 %>
                  <div class="text-[11px] text-blue-500 pt-1 font-medium">
                    + <%= category.targets.count - 5 %> more websites...
                  </div>
                <% end %>
              <% else %>
                <p class="text-xs text-gray-400 italic py-2">No target sites linked yet.</p>
              <% end %>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex justify-between items-center text-sm">
            <%= link_to 'Manage Sites →', category_path(category), class: "text-blue-600 font-semibold hover:text-blue-800 transition" %>
            <div class="flex space-x-3">
              <%= link_to 'Edit', edit_category_path(category), class: "text-gray-500 hover:text-gray-700" %>
              <%= button_to 'Delete', category_path(category), method: :delete, data: { confirm: "Are you sure? This will delete the category and all its #{category.targets.count} linked sites!" }, class: "text-red-500 hover:text-red-700 cursor-pointer text-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full text-center py-16 bg-gray-50 border-2 border-dashed border-gray-200 rounded-xl">
        <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        <p class="text-base font-medium text-gray-600">No target categories created yet</p>
        <p class="text-xs text-gray-400 mt-1">Categories help organize your scraping targets (e.g., "ATS Platforms", "Job Boards").</p>
      </div>
    <% end %>
  </div>

</div>