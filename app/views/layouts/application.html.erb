<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brute Force Finder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brute Force Finder">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-breeze-bg text-breeze-text flex flex-col min-h-screen">
    <div id="flash">
      <%= render "layouts/flash" %>
    </div>

    <% if current_user.present? %>
      <nav class="bg-breeze-view border-b border-breeze-border sticky top-0 z-50 shadow-sm h-16 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="flex justify-between h-full items-center">

            <div class="flex items-center space-x-8">
              <div class="flex-shrink-0 flex items-center">
                <%= link_to root_path, class: "text-xl font-bold text-breeze-accent tracking-wide flex items-center gap-2" do %>
                  ⚡ Brute Force Finder
                <% end %>
              </div>

              <div class="hidden md:flex space-x-2">
                <%= link_to "Searches", searches_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
                <%= link_to "Results", results_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
                <%= link_to "Categories", categories_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
                <%= link_to "Statistics", dashboard_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              <%= link_to data_transfers_path, class: "flex items-center gap-2 bg-breeze-bg hover:bg-gray-700 text-breeze-text px-3.5 py-1.5 rounded-lg text-sm font-medium border border-breeze-border transition" do %>
                🔄 Sync & Data
              <% end %>

              <div class="h-5 w-px bg-breeze-border hidden sm:block"></div>

              <div class="flex items-center space-x-3 text-sm">
                <div class="hidden lg:flex flex-col text-right leading-tight">
                  <span class="font-medium text-gray-200 truncate max-w-[160px]" title="<%= current_user.email %>">
                    <%= current_user.email %>
                  </span>
                </div>

                <%= link_to destroy_user_session_path,
                            data: { turbo_method: :delete },
                            class: "flex items-center gap-1.5 text-gray-400 hover:text-red-400 hover:bg-red-500/10 px-2.5 py-1.5 rounded-md text-sm transition",
                            title: "Log out" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                  </svg>
                  <span class="hidden sm:inline">Log out</span>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      </nav>
    <% end %>

    <main class="flex-grow pt-3 pb-12">
      <%= yield %>
    </main>
  </body>
</html>