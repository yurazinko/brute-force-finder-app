<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brute Force Finder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brute Force Finder">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-breeze-bg text-breeze-text flex flex-col min-h-screen">
    <%= render "layouts/flash" %>

    <nav class="bg-breeze-view border-b border-breeze-border sticky top-0 z-50 shadow-sm h-16 flex items-center">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="flex justify-between h-full items-center">
          <div class="flex items-center space-x-8">
            <div class="flex-shrink-0 flex items-center">
              <%= link_to root_path, class: "text-xl font-bold text-breeze-accent tracking-wide flex items-center gap-2" do %>
                ⚡ Brute Force Finder
              <% end %>
            </div>

            <div class="hidden md:flex space-x-4">
              <%= link_to "Searches", searches_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
              <%= link_to "Categories", categories_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
              <%= link_to "Statistics", dashboard_path, class: "text-gray-300 hover:text-breeze-accent px-3 py-2 rounded-md text-sm font-medium transition" %>
            </div>
          </div>

          <div class="flex items-center">
            <%= link_to data_transfers_path, class: "flex items-center gap-2 bg-breeze-bg hover:bg-gray-200 text-breeze-text px-4 py-2 rounded-lg text-sm font-medium border border-breeze-border transition" do %>
              🔄 Sync & Data
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow pt-3 pb-12">
      <%= yield %>
    </main>

  </body>
</html>