<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brute Force Finder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brute Force Finder">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-breeze-bg text-breeze-text flex flex-col min-h-screen antialiased selection:bg-breeze-accent/30 selection:text-breeze-accent">
    <!-- Flash Notifications Container -->
    <div id="flash" class="sticky top-0 z-50">
      <%= render "layouts/flash" %>
    </div>

    <% if current_user.present? %>
      <!-- Navigation Bar -->
      <nav class="bg-breeze-view/90 backdrop-blur-md border-b border-breeze-border/80 sticky top-0 z-40 shadow-xs h-16 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="flex justify-between items-center h-full">

            <!-- Left Group: Logo + Main Navigation -->
            <div class="flex items-center gap-6 lg:gap-8">
              <!-- Brand Logo -->
              <div class="shrink-0 flex items-center">
                <%= link_to root_path, class: "text-lg sm:text-xl font-extrabold tracking-wide text-breeze-accent hover:opacity-90 transition flex items-center gap-2" do %>
                  <span class="p-1.5 rounded-lg bg-breeze-accent/10 border border-breeze-accent/20 text-breeze-accent text-sm">⚡</span>
                  <span class="bg-gradient-to-r from-breeze-text to-breeze-accent bg-clip-text text-transparent">
                    Brute Force Finder
                  </span>
                <% end %>
              </div>

              <!-- Main Links -->
              <div class="hidden md:flex items-center space-x-1 font-medium text-xs sm:text-sm">
                <%= link_to searches_path, class: "px-3 py-1.5 rounded-lg transition-all #{current_page?(searches_path) ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border border-breeze-accent/30 shadow-xs' : 'text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Searches
                <% end %>

                <%= link_to results_path, class: "px-3 py-1.5 rounded-lg transition-all #{current_page?(results_path) ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border border-breeze-accent/30 shadow-xs' : 'text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Results
                <% end %>

                <%= link_to categories_path, class: "px-3 py-1.5 rounded-lg transition-all #{current_page?(categories_path) ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border border-breeze-accent/30 shadow-xs' : 'text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Categories
                <% end %>

                <%= link_to dashboard_path, class: "px-3 py-1.5 rounded-lg transition-all #{current_page?(dashboard_path) ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border border-breeze-accent/30 shadow-xs' : 'text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Statistics
                <% end %>
              </div>
            </div>

            <!-- Right Group: Actions + Profile -->
            <div class="flex items-center space-x-3 sm:space-x-4">
              <!-- Data Sync Link -->
              <%= link_to data_transfers_path, class: "flex items-center gap-2 bg-breeze-bg/80 hover:bg-breeze-bg text-breeze-text px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold border border-breeze-border/80 hover:border-breeze-border transition shadow-2xs" do %>
                <span class="text-xs">🔄</span>
                <span>Sync & Data</span>
              <% end %>

              <div class="h-5 w-px bg-breeze-border/60 hidden sm:block"></div>

              <!-- User Profile & Logout -->
              <div class="flex items-center space-x-2 sm:space-x-3 text-xs sm:text-sm">
                <div class="hidden lg:flex flex-col text-right leading-tight">
                  <span class="font-semibold text-breeze-text truncate max-w-[160px]" title="<%= current_user.email %>">
                    <%= current_user.email %>
                  </span>
                </div>

                <%= link_to destroy_user_session_path,
                            data: { turbo_method: :delete },
                            class: "flex items-center gap-1.5 text-breeze-muted hover:text-red-400 hover:bg-red-500/10 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-transparent hover:border-red-500/20 transition",
                            title: "Log out" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                  </svg>
                  <span class="hidden sm:inline">Log out</span>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      </nav>
    <% end %>

    <!-- Main Content Body -->
    <main class="flex-grow pt-4 pb-12">
      <%= yield %>
    </main>
  </body>
</html>