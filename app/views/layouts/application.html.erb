<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brute Force Finder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brute Force Finder">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-breeze-bg text-breeze-text flex flex-col min-h-screen antialiased selection:bg-breeze-accent/30 selection:text-breeze-accent">
    <!-- Flash Notifications Container -->
    <div id="flash-wrapper" data-controller="flash">
      <%= render "layouts/flash" %>
    </div>

    <%= turbo_frame_tag "modal" %>

    <% if current_user.present? %>
      <!-- Navigation Bar -->
      <nav class="bg-breeze-view/90 backdrop-blur-md border-b border-breeze-border/80 sticky top-0 z-40 shadow-xs h-16 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="flex justify-between items-center h-full">

            <!-- Left Group: Logo + Main Navigation -->
            <div class="flex items-center gap-6 lg:gap-8">
              <!-- Brand Logo -->
              <div class="shrink-0 flex items-center">
                <%= link_to root_path, class: "text-lg sm:text-xl font-extrabold tracking-wide text-breeze-accent hover:opacity-90 transition flex items-center gap-2" do %>
                  <span class="p-1.5 rounded-lg bg-breeze-accent/10 border border-breeze-accent/20 text-breeze-accent text-sm">⚡</span>
                  <span class="bg-gradient-to-r from-breeze-text to-breeze-accent bg-clip-text text-transparent">
                    Brute Force Finder
                  </span>
                <% end %>
              </div>

              <!-- Main Links -->
              <div class="hidden md:flex items-center space-x-1 font-medium text-xs sm:text-sm">
                <%= link_to root_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "quick_searches" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Quick Search
                <% end %>

                <%= link_to searches_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "searches" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Campaigns
                <% end %>

                <%= link_to results_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "results" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Results
                <% end %>

                <%= link_to categories_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{%w[categories targets target_patterns].include?(controller_name) ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                  Targets
                <% end %>

                <!-- Statistics Link with Dead Targets Alert Badge -->
                <div class="relative inline-flex items-center">
                  <%= link_to dashboard_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "dashboards" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'}" do %>
                    Statistics
                  <% end %>

                  <% if @dead_targets_alert %>
                    <span class="absolute text-[10px] select-none pointer-events-auto cursor-help"
                          style="right: calc(var(--spacing) * 0.6); bottom: calc(var(--spacing) * 0.4);"
                          title="You have dead targets in your searches.">
                      ⚠️
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Right Group: Sync, Profile Settings & Logout -->
            <div class="flex items-center space-x-1 font-medium text-xs sm:text-sm">
              <!-- Data Sync Link -->
              <%= link_to data_transfers_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "data_transfers" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'} flex items-center gap-1.5" do %>
                <span>🔄</span>
                <span>Sync</span>
              <% end %>

              <!-- Edit Profile Link -->
              <%= link_to edit_user_registration_path, class: "px-3 py-1.5 rounded-lg border transition-colors #{controller_name == "registrations" && action_name == "edit" ? 'bg-breeze-accent/15 text-breeze-accent font-semibold border-breeze-accent/30 shadow-xs' : 'border-transparent text-breeze-muted hover:text-breeze-text hover:bg-breeze-bg/60'} flex items-center gap-1.5" do %>
                <span>👤</span>
                <span class="max-w-[120px] truncate" title="<%= current_user.username %>"><%= current_user.username %></span>
              <% end %>

              <div class="h-4 w-px bg-breeze-border/60 mx-1"></div>

              <!-- Log out Button -->
              <%= link_to destroy_user_session_path,
                          data: { turbo_method: :delete },
                          class: "px-3 py-1.5 rounded-lg border border-transparent transition-colors text-red-400 hover:text-red-300 hover:bg-red-500/10 flex items-center gap-1.5",
                          title: "Log out" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                </svg>
                <span class="hidden sm:inline">Log out</span>
              <% end %>
            </div>

          </div>
        </div>
      </nav>
    <% else %>
      <nav class="bg-breeze-view/80 backdrop-blur-md border-b border-breeze-border/60 sticky top-0 z-40 h-14 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex items-center justify-between">
          <%= link_to root_path, class: "text-base sm:text-lg font-extrabold tracking-wide text-breeze-accent hover:opacity-90 transition flex items-center gap-2" do %>
            <span class="p-1 rounded-lg bg-breeze-accent/10 border border-breeze-accent/20 text-xs">⚡</span>
            <span class="bg-gradient-to-r from-breeze-text to-breeze-accent bg-clip-text text-transparent">
              Brute Force Finder
            </span>
          <% end %>

          <% unless controller_name == "sessions" %>
            <%= link_to new_user_session_path,
                        class: "px-3 py-1.5 rounded-lg border border-breeze-border/80 bg-breeze-bg/50 text-xs sm:text-sm font-medium text-breeze-muted hover:text-breeze-text hover:border-breeze-accent/40 hover:bg-breeze-accent/10 transition-colors" do %>
              Log in
            <% end %>
          <% end %>
        </div>
      </nav>
    <% end %>

    <!-- Main Content Body -->
    <main class="flex-grow pb-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-breeze-border/50 bg-breeze-view/40 text-xs text-breeze-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1">
          <span class="font-medium text-breeze-text/80">Brute Force Finder</span>
          <span class="text-breeze-border">•</span>
          <span>
            Powered by
            <%= link_to "Degoog", "https://degoog.org", target: "_blank", rel: "noopener noreferrer", class: "underline decoration-breeze-border/80 underline-offset-2 hover:text-breeze-accent transition-colors" %>,
            <%= link_to "SearXNG", "https://docs.searxng.org", target: "_blank", rel: "noopener noreferrer", class: "underline decoration-breeze-border/80 underline-offset-2 hover:text-breeze-accent transition-colors" %>,
            <%= link_to "YaCy", "https://yacy.net", target: "_blank", rel: "noopener noreferrer", class: "underline decoration-breeze-border/80 underline-offset-2 hover:text-breeze-accent transition-colors" %>,
            <%= link_to "4get", "https://4get.ca", target: "_blank", rel: "noopener noreferrer", class: "underline decoration-breeze-border/80 underline-offset-2 hover:text-breeze-accent transition-colors" %>
            and
            <%= link_to "Tor", "https://www.torproject.org", target: "_blank", rel: "noopener noreferrer", class: "underline decoration-breeze-border/80 underline-offset-2 hover:text-breeze-accent transition-colors" %>
          </span>
        </div>

        <div class="flex items-center">
          <%= link_to "https://github.com/yurazinko/brute-force-finder-app",
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "inline-flex items-center gap-1.5 text-breeze-muted hover:text-breeze-text transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub</span>
          <% end %>
        </div>
      </div>
    </footer>
  </body>
</html>
