<% flash.each do |type, message| %>
  <div class="max-w-5xl mx-auto px-4 mt-4">
    <% if type == "notice" %>
      <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg flex items-center space-x-3 shadow-sm" role="alert">
        <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium"><%= message %></span>
      </div>
    <% elsif type == "alert" || type == "error" %>
      <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg flex items-center space-x-3 shadow-sm" role="alert">
        <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium"><%= message %></span>
      </div>
    <% else %>
      <div class="p-4 bg-blue-50 border border-blue-200 text-blue-800 rounded-lg flex items-center space-x-3 shadow-sm" role="alert">
        <span class="text-sm font-medium"><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>