<div id="flash-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4 sm:px-0">
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div class="flash-message pointer-events-auto transition-all duration-300 transform translate-y-0 opacity-100 p-4 rounded-xl border shadow-lg flex items-start justify-between gap-3 backdrop-blur-md <%=
      case type.to_s
      when "notice", "success"
        "bg-green-950/90 border-green-500/30 text-green-200"
      when "alert", "error"
        "bg-red-950/90 border-red-500/30 text-red-200"
      else
        "bg-blue-950/90 border-blue-500/30 text-blue-200"
      end
    %>" role="alert">
      <div class="flex items-center space-x-3">
        <% if type.to_s == "notice" || type.to_s == "success" %>
          <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        <% elsif type.to_s == "alert" || type.to_s == "error" %>
          <svg class="w-5 h-5 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        <% else %>
          <svg class="w-5 h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        <% end %>
        <span class="text-sm font-medium"><%= message %></span>
      </div>

      <button type="button" data-action="click->flash#dismiss" class="text-breeze-muted hover:text-white transition p-1 shrink-0" aria-label="Close">
        ✕
      </button>
    </div>
  <% end %>
</div>
