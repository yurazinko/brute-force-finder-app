<div id="<%= dom_id(target) %>" class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-breeze-bg px-3 rounded-lg transition border-b border-breeze-border/40 last:border-0">
  <div class="space-y-1.5 flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="font-semibold text-breeze-text text-sm"><%= target.name %></span>
      <span class="text-xs text-breeze-muted font-mono"><%= target.domain %></span>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
      <% if target.target_patterns.any? %>
        <% target.target_patterns.each do |pattern| %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono <%= pattern.is_active? ? 'bg-breeze-view text-breeze-accent border border-breeze-accent/30' : 'bg-gray-500/10 text-gray-400 border border-gray-500/20 line-through' %>" title="Path pattern">
            <span>🛤️</span>
            <span><%= pattern.path_pattern %></span>
          </span>
        <% end %>
      <% else %>
        <span class="text-[11px] text-breeze-muted/60 italic">All paths accepted (no patterns)</span>
      <% end %>
    </div>
  </div>

  <div class="flex items-center space-x-2 shrink-0">
    <%= button_to target_path(target),
                  method: :patch,
                  params: { target: { is_active: !target.is_active? } },
                  class: "inline-flex items-center px-2 py-1 rounded text-xs font-semibold border transition cursor-pointer #{target.is_active? ? 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' : 'bg-breeze-bg text-gray-300 border-breeze-border hover:bg-breeze-bg'}" do %>
      <span class="mr-1.5 flex h-1.5 w-1.5 items-center">
        <span class="absolute inline-flex h-1.5 w-1.5 rounded-full <%= target.is_active? ? 'bg-green-500 animate-pulse' : 'bg-gray-400' %>"></span>
      </span>
      <%= target.is_active? ? 'Active' : 'Disabled' %>
    <% end %>

    <%= link_to "Edit", edit_target_path(target), class: "text-xs text-breeze-muted hover:text-breeze-accent font-medium px-2.5 py-1 border border-breeze-border rounded hover:border-indigo-200 transition bg-breeze-view" %>

    <%= button_to "Remove", target_path(target),
                  method: :delete,
                  data: { confirm: "Delete #{target.name}?" },
                  class: "text-xs text-breeze-muted hover:text-red-600 font-medium px-2.5 py-1 border border-breeze-border rounded hover:border-red-200 hover:bg-red-50/30 transition cursor-pointer bg-breeze-view" %>
  </div>
</div>