<div id="<%= dom_id(target) %>" class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-breeze-bg px-3 rounded-lg transition border-b border-breeze-border/40 last:border-0">
  <div class="space-y-1.5 flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="font-semibold text-breeze-text text-sm"><%= target.name %></span>
      <span class="text-xs text-breeze-muted font-mono"><%= target.domain %></span>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
      <% if target.target_patterns.any? %>
        <% target.target_patterns.each do |pattern| %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-mono max-w-full break-all <%= pattern.is_active? ? 'bg-breeze-view text-breeze-accent border border-breeze-accent/30' : 'bg-breeze-bg text-breeze-muted border border-breeze-border/60 line-through' %>" title="Path pattern">
            <span>🛤️</span>
            <span><%= pattern.path_pattern %></span>
          </span>
        <% end %>
      <% else %>
        <span class="text-[11px] text-breeze-muted/60 italic">All paths accepted (no patterns)</span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2 shrink-0">
    <%= button_to target_path(target),
                  method: :patch,
                  params: { target: { is_active: !target.is_active? } },
                  class: "inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-semibold border transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent focus-visible:ring-offset-2 focus-visible:ring-offset-breeze-view #{target.is_active? ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30 hover:bg-emerald-500/15' : 'bg-breeze-bg text-breeze-muted border-breeze-border hover:bg-breeze-bg/80'}" do %>
      <span class="relative mr-1.5 flex h-1.5 w-1.5 shrink-0 items-center justify-center">
        <span class="absolute inline-flex h-1.5 w-1.5 rounded-full <%= target.is_active? ? 'bg-emerald-400 animate-pulse' : 'bg-breeze-muted/60' %>"></span>
      </span>
      <%= target.is_active? ? 'Active' : 'Disabled' %>
    <% end %>

    <%= link_to "Edit", edit_target_path(target), class: "text-xs text-breeze-muted hover:text-breeze-text font-semibold px-3 py-1.5 border border-breeze-border rounded-lg hover:border-breeze-accent/40 hover:bg-breeze-bg/60 transition bg-breeze-view focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-breeze-accent focus-visible:ring-offset-2 focus-visible:ring-offset-breeze-view" %>

    <%= button_to "Delete", target_path(target),
                  method: :delete,
                  data: { turbo_confirm: "Delete #{target.name}?" },
                  class: "text-xs text-red-400 hover:text-red-300 font-semibold px-3 py-1.5 border border-red-500/20 rounded-lg hover:border-red-500/40 hover:bg-red-500/10 transition cursor-pointer bg-breeze-view focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-breeze-view" %>
  </div>
</div>

