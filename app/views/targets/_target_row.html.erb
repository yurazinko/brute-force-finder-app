<div id="<%= dom_id(target) %>" class="py-3 flex justify-between items-center hover:bg-breeze-bg px-2 rounded-lg transition">
  <div>
    <div class="font-medium text-breeze-text text-sm"><%= target.name %></div>
    <div class="text-xs text-breeze-muted font-mono"><%= target.domain %></div>
  </div>
  <div class="flex items-center space-x-3">
    <%= button_to target_path(target),
                  method: :patch,
                  params: { target: { is_active: !target.is_active? } },
                  class: "inline-flex items-center px-2 py-1 rounded text-xs font-semibold border transition cursor-pointer #{target.is_active? ? 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' : 'bg-breeze-bg text-gray-300 border-breeze-border hover:bg-breeze-bg'}" do %>
      <span class="mr-1.5 flex h-1.5 w-1.5 items-center">
        <span class="absolute inline-flex h-1.5 w-1.5 rounded-full <%= target.is_active? ? 'bg-green-500 animate-pulse' : 'bg-gray-400' %>"></span>
      </span>
      <%= target.is_active? ? 'Active' : 'Disabled' %>
    <% end %>

    <%= link_to "Edit", edit_target_path(target), class: "text-xs text-breeze-muted hover:text-breeze-accent font-medium px-2 py-1 border border-breeze-border rounded hover:border-indigo-200 transition" %>

    <%= button_to "Remove", target_path(target),
                  method: :delete,
                  data: { confirm: "Delete #{target.name}?" },
                  class: "text-xs text-breeze-muted hover:text-red-600 font-medium px-2 py-1 border border-breeze-border rounded hover:border-red-200 hover:bg-red-50/30 transition cursor-pointer" %>
  </div>
</div>