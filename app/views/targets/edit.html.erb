<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 space-y-4 sm:space-y-6">

  <!-- Header / Breadcrumbs Bar -->
  <div class="bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <%= link_to category_path(@target.category), class: "inline-flex items-center gap-1.5 text-xs font-semibold text-breeze-muted hover:text-breeze-text transition bg-breeze-bg/50 px-2.5 py-1 rounded-md border border-breeze-border/60" do %>
        <span>⬅️</span>
        <span>Back to Category</span>
      <% end %>
      <h1 class="text-xl sm:text-2xl font-bold text-breeze-text mt-2 flex items-center gap-2">
        <span>⚙️</span>
        <span>Edit Target Site: <%= @target.name %></span>
      </h1>
      <p class="text-xs text-breeze-muted mt-1 font-mono">ID: <%= @target.id %> | Linked Category: <strong class="text-breeze-text"><%= @target.category.name %></strong></p>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs font-mono font-bold px-3 py-1 rounded-full border <%= @target.is_active? ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-gray-500/10 text-gray-400 border-gray-500/20' %>">
        <%= @target.is_active? ? 'Active Pipeline' : 'Inactive' %>
      </span>
    </div>
  </div>

  <!-- Main Grid Layout (Swapped positions, keeping sizes: Target config = col-span-1, Path patterns = col-span-2) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 items-start">

    <!-- Left Column: General Target Settings (1 col - compact) -->
    <div class="lg:col-span-1 bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl space-y-6">
      <div class="border-b border-breeze-border/60 pb-3">
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>🛠️</span>
          <span>Target Configuration</span>
        </h2>
        <p class="text-[11px] text-breeze-muted mt-0.5">Manage domain matching rules.</p>
      </div>

      <%= form_with(model: @target, local: true, class: "space-y-5") do |f| %>

        <% if @target.errors.any? %>
          <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg text-xs space-y-1">
            <p class="font-bold">Please fix the following errors:</p>
            <ul class="list-disc pl-4 space-y-0.5">
              <% @target.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Site Name", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name, placeholder: "e.g., Workable",
                             class: "w-full text-sm bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2.5 outline-none transition" %>
        </div>

        <div>
          <%= f.label :domain, "Domain (Triggers Prompt Sync)", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :domain, placeholder: "e.g., workable.com",
                             class: "w-full text-sm font-mono bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2.5 outline-none transition" %>
          <p class="text-[11px] text-amber-400/90 mt-2 leading-relaxed font-sans bg-amber-500/10 p-2.5 rounded-lg border border-amber-500/20 flex items-start gap-2">
            <span>⚠️</span>
            <span><strong>Note:</strong> Changing the domain will automatically update all search engine queries associated with this target site.</span>
          </p>
        </div>

        <div class="p-3.5 bg-breeze-bg rounded-lg border border-breeze-border/60 space-y-3">
          <div class="flex items-center gap-3">
            <%= f.check_box :is_active, class: "h-4 w-4 rounded border-breeze-border bg-breeze-view text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
            <%= f.label :is_active, "Pipeline Status Active", class: "text-xs font-semibold text-breeze-text cursor-pointer select-none" %>
          </div>

          <div class="flex items-center gap-3 pt-2 border-t border-breeze-border/40">
            <%= f.check_box :allow_query_strings, class: "h-4 w-4 rounded border-breeze-border bg-breeze-view text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
            <%= f.label :allow_query_strings, "Keep URL Query Parameters", class: "text-xs font-semibold text-breeze-text cursor-pointer select-none" %>
          </div>
          <p class="text-[10px] text-breeze-muted pl-7 leading-relaxed">
            Enabling this will prevent the system from stripping query strings (e.g., <code>?jk=...</code>) for tracking-heavy sites.
          </p>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t border-breeze-border/60">
          <%= f.submit "Save Changes", class: "flex-1 py-2.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs rounded-lg shadow-md transition cursor-pointer text-center" %>
          <%= link_to "Cancel", category_path(@target.category), class: "px-4 py-2.5 border border-breeze-border hover:bg-breeze-bg text-breeze-muted hover:text-breeze-text text-xs font-semibold rounded-lg transition text-center" %>
        </div>

      <% end %>
    </div>

    <!-- Right Column: Path Patterns Studio & List (2 cols - wide) -->
    <div class="lg:col-span-2 bg-breeze-view p-4 sm:p-6 shadow-sm border border-breeze-border rounded-xl space-y-6">
      <div class="border-b border-breeze-border/60 pb-3">
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>✨</span>
          <span>Path Patterns Studio & Configured Rules</span>
        </h2>
        <p class="text-[11px] text-breeze-muted mt-0.5">Manage exact and wildcard path rules for <strong><%= @target.domain %></strong>.</p>
      </div>

      <% sample_url = "https://#{@target.domain}/company/example-job/123" %>
      <%
         uri_obj = URI.parse(sample_url) rescue nil
         default_path = uri_obj&.path.presence || "/"
         clean_path = default_path.sub(%r{\A/+}, "").chomp("/")
         path_segments = clean_path.split("/")
      %>

      <!-- Renders the shared unified form partial -->
      <%= render "target_patterns/form",
                 target_pattern: TargetPattern.new,
                 result: nil,
                 matched_target: @target,
                 search: nil,
                 redirect_path: edit_target_path(@target),
                 path_segments: path_segments,
                 default_path: default_path %>
    </div>

  </div>
</div>