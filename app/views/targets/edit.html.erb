<div class="max-w-xl mx-auto px-4 py-8 space-y-6">
  <div class="mb-6">
    <%= link_to "⬅️ Back to Category", category_path(@target.category), class: "text-sm text-breeze-muted hover:text-breeze-text transition" %>
    <h1 class="text-2xl font-bold text-breeze-text mt-2">Edit Target Site</h1>
    <p class="text-xs text-breeze-muted mt-1 font-mono">ID: <%= @target.id %> | Linked to <%= @target.category.name %></p>
  </div>

  <div class="bg-breeze-view p-6 shadow-sm border border-breeze-border rounded-xl space-y-6">
    <%= form_with(model: @target, local: true, class: "space-y-5") do |f| %>

      <% if @target.errors.any? %>
        <div class="p-4 bg-red-50/10 border border-red-500/20 text-red-400 rounded-lg text-xs space-y-1">
          <p class="font-bold">Please fix the following errors:</p>
          <ul class="list-disc pl-4 space-y-0.5">
            <% @target.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Site Name", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :name, placeholder: "e.g., Workable",
                           class: "w-full text-sm bg-breeze-bg text-breeze-text rounded-lg border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2 outline-none transition" %>
      </div>

      <div>
        <%= f.label :domain, "Domain (Triggers Prompt Sync)", class: "block text-xs font-semibold text-breeze-muted uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :domain, placeholder: "e.g., workable.com",
                           class: "w-full text-sm font-mono bg-breeze-bg text-breeze-text rounded-lg border-breeze-border shadow-sm focus:border-breeze-accent focus:ring-breeze-accent px-3 py-2 outline-none transition" %>
        <p class="text-[10px] text-amber-400/80 mt-1.5 leading-relaxed font-sans">
          ⚠️ <strong>Note:</strong> Changing the domain will automatically update all search engine queries associated with this target site.
        </p>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.check_box :is_active, class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
        <%= f.label :is_active, "Pipeline Status Active", class: "text-xs font-medium text-breeze-text cursor-pointer select-none" %>
      </div>

      <div class="flex flex-col gap-1 pt-2">
        <div class="flex items-center gap-3">
          <%= f.check_box :allow_query_strings, class: "h-4 w-4 rounded border-breeze-border bg-breeze-bg text-breeze-accent focus:ring-breeze-accent cursor-pointer" %>
          <%= f.label :allow_query_strings, "Keep URL Query Parameters", class: "text-xs font-medium text-breeze-text cursor-pointer select-none" %>
        </div>
        <p class="text-[10px] text-breeze-muted pl-7 leading-relaxed">
          Enabling this will prevent the system from stripping query strings (e.g., <code>?jk=...</code>) for tracking-heavy sites.
        </p>
      </div>

      <div class="flex items-center gap-3 pt-4 border-t border-breeze-border/60">
        <%= f.submit "Save Changes", class: "flex-1 py-2 px-4 bg-breeze-accent hover:bg-opacity-90 text-white font-medium text-sm rounded-lg shadow cursor-pointer transition-all text-center" %>
        <%= link_to "Cancel", category_path(@target.category), class: "px-4 py-2 border border-breeze-border hover:bg-breeze-bg text-breeze-muted hover:text-breeze-text text-sm rounded-lg transition text-center" %>
      </div>

    <% end %>
  </div>

  <!-- Associated Path Patterns Section -->
  <div class="bg-breeze-view p-6 shadow-sm border border-breeze-border rounded-xl space-y-4">
    <div class="flex items-center justify-between border-b border-breeze-border/60 pb-3">
      <div>
        <h2 class="text-xs font-bold text-breeze-muted uppercase tracking-wider flex items-center gap-1.5">
          <span>🛤️</span>
          <span>Configured URL Path Patterns</span>
        </h2>
        <p class="text-[11px] text-breeze-muted mt-0.5">If no patterns are added, all paths under <strong><%= @target.domain %></strong> are accepted.</p>
      </div>
      <span class="bg-breeze-accent/10 text-breeze-accent border border-breeze-accent/20 text-xs font-mono font-bold px-2.5 py-0.5 rounded-full">
        <%= @target.target_patterns.size %>
      </span>
    </div>

    <!-- Patterns List -->
    <div class="space-y-2">
      <% if @target.target_patterns.any? %>
        <% @target.target_patterns.each do |pattern| %>
          <div class="flex items-center justify-between bg-breeze-bg p-3 rounded-lg border border-breeze-border/60 font-mono text-xs">
            <div class="flex items-center gap-2 truncate">
              <span class="text-breeze-accent font-bold"><%= pattern.path_pattern %></span>
              <span class="text-[10px] px-2 py-0.5 rounded <%= pattern.is_active? ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-gray-500/10 text-gray-400' %>">
                <%= pattern.is_active? ? 'Active' : 'Disabled' %>
              </span>
            </div>

            <div class="flex items-center gap-2 font-sans">
              <!-- Toggle status button -->
              <%= button_to target_pattern_path(pattern, target_pattern: { is_active: !pattern.is_active? }),
                            method: :patch,
                            class: "text-[11px] px-2 py-1 bg-breeze-view hover:bg-breeze-border/40 text-breeze-muted hover:text-breeze-text border border-breeze-border rounded transition cursor-pointer" do %>
                <%= pattern.is_active? ? 'Disable' : 'Enable' %>
              <% end %>

              <!-- Delete pattern -->
              <%= button_to "Delete", target_pattern_path(pattern),
                            method: :delete,
                            data: { confirm: "Are you sure you want to delete this pattern?" },
                            class: "text-[11px] px-2 py-1 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 rounded transition cursor-pointer" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-6 bg-breeze-bg/40 rounded-lg border border-dashed border-breeze-border/60 text-xs text-breeze-muted italic">
          No custom path patterns configured. Add one below or configure it directly from discovered results.
        </div>
      <% end %>
    </div>

    <!-- Quick Add Pattern Form -->
    <div class="pt-4 border-t border-breeze-border/60">
      <h3 class="text-xs font-semibold text-breeze-text mb-2">Add New Path Pattern</h3>
      <%= form_with model: TargetPattern.new, url: target_patterns_path, method: :post, class: "flex gap-2" do |f| %>
        <%= f.hidden_field :target_id, value: @target.id %>
        <%= f.text_field :path_pattern, placeholder: "e.g., /jobs/* or /careers/{id}", class: "flex-1 text-xs font-mono bg-breeze-bg text-breeze-text rounded-lg border border-breeze-border px-3 py-2 outline-none focus:border-breeze-accent" %>
        <%= f.submit "Add Pattern", class: "py-2 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-xs rounded-lg shadow-sm hover:from-blue-500 hover:to-indigo-500 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>